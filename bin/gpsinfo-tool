#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);
use Date::Format qw(time2str);
use Date::Parse qw(str2time);

use GIS::Distance;

sub getGpsReadings($$);
sub getCheckPointGpsReadings($@);
sub parseCourse($);
sub parseCheckPointSegments(@);
sub formatKML($@);
sub formatHMS($);

my $EXEC = basename $0;

my $GPSINFO_BAK_DIR = "$ENV{HOME}/Code/sx/backup/backup-gpsinfo";
my $GPSINFO_LOG_DIR = "$ENV{HOME}/.cache/harbour-gpsinfo/harbour-gpsinfo";

my $MILES_PER_KM = 0.62137119;

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC --kml START_TIME [END_TIME]
    -get <GPS_READING>s as in:
      $EXEC --get START_TIME END_TIME
    -format as KML and print
      -each GPS_READING is a <Placemark>
      -ID field is GPS_READING_EPOCH_MILLIS

  $EXEC COURSE_NAME START_TIME [END_TIME]
  $EXEC -c|--course COURSE_NAME START_TIME [END_TIME]
  $EXEC -w|--workout COURSE_NAME START_TIME [END_TIME]
    -get <GPS_READING>s as in:
      $EXEC --get START_TIME END_TIME
    -for each GPS_READING:
      -calculate the DIST as the haversine distance in meters to each CHECK_POINT
      -if DIST is < 10m for a CHECK_POINT:
        -find the smallest DIST adjacent GPS_READING, and use that as the CHECK_POINT_GPS_READING
        -add the distance for that CHECK_POINT to the CURRENT_DIST_SUM
        -if CURRENT_DIST_SUM is above the TARGET_DIST for that CHECK_POINT
          -include CHECK_POINT_GPS_READING as a SEGMENT_CHECK_POINT_GPS_READING
    -for each SEGMENT_CHECK_POINT_GPS_READING:
      -calculate the <SEGMENT_DISTANCE> since previous SEGMENT_CHECK_POINT_GPS_READING
      -calculate the <SEGMENT_DURATION> since previous SEGMENT_CHECK_POINT_GPS_READING
      -format SEGMENT_FMT as <SEGMENT_DURATION>s:<SEGMENT_DISTANCE>m
    -format summary of course distance/duration/segments
    -format workout with total distance, total duration, and segments

  $EXEC --checkpoint|--check-point|--run|--race COURSE_NAME START_TIME [END_TIME]
    -get all <CHECK_POINT_GPS_READING>s as in:
      $EXEC --course COURSE_NAME <START_TIME> \"\$(date)\"
    -use the oldest CHECK_POINT_GPS_READING as FIRST_CHECK_POINT
    -use the most-recent CHECK_POINT_GPS_READING as CUR_CHECK_POINT
    -use the second-most-recent CHECK_POINT_GPS_READING as PREV_CHECK_POINT
    -calculate SEGMENT_DIST as the distance between prev and cur:
      CUR_CHECK_POINT.DISTANCE
    -calculate SEGMENT_DUR_MILLIS as elapsed millis between prev and cur:
      CUR_CHECK_POINT.GPS_READING_EPOCH_MILLIS - PREV_CHECK_POINT.GPS_READING_EPOCH_MILLIS
    -calculate SEGMENT_SPEED_MPH as
      (SEGMENT_DIST/1000) / (SEGMENT_DUR_MILLIS/1000/60/60) * $MILES_PER_KM
    -calculate TOTAL_DIST as the dist from FIRST_CHECK_POINT to CUR_CHECK_POINT
    -calculate TOTAL_DUR_MILLIS as elapsed millis between FIRST_CHECK_POINT and CUR_CHECK_POINT
    -calculate TOTAL_SPEED_MPH as
      (TOTAL_DIST/1000) / (TOTAL_DUR_MILLIS/1000/60/60) * $MILES_PER_KM
    -calculate TOTAL_DIST_KM as TOTAL_DIST/1000
    -print:
      <CUR_CHECK_POINT.NAME>,<TOTAL_DIST_KM>,<SEGMENT_SPEED_MPH>mph,<TOTAL_SPEED_MPH>mph

  $EXEC START_TIME [END_TIME]
  $EXEC -g|--get START_TIME [END_TIME]
    -if not given, use current date/time for END_TIME
    -parse date range as seconds since epoch:
      -parse START_TIME as a date format string into START_EPOCH_S
      -parse END_TIME as a date format string into END_EPOCH_S
    -list gpsinfo csv <LOG_FILE>s:
      $GPSINFO_BAK_DIR/harbour-gpsinfo-<LOG_EPOCH_MILLIS>*.log*
      $GPSINFO_LOG_DIR/harbour-gpsinfo-<LOG_EPOCH_MILLIS>*.log*
    -get <MATCHING_LOG_FILE>s:
      -for each LOG_FILE:
        -truncate LOG_EPOCH_MILLIS to LOG_EPOCH_S (ignore millis)
        -include the *most recent* LOG_FILE where:
            LOG_EPOCH_S <= START_EPOCH_S
        -include all LOG_FILEs where:
            START_EPOCH_S <= LOG_EPOCH_S <= END_EPOCH_S
    -parse each GPS_READING csv row in each MATCHING_LOG_FILE, decompressing if necessary
       -format of each GPS_READING:
         <GPS_READING_EPOCH_MILLIS>,
         <DATE_FMT>,
         lat=<LAT>,lon=<LON>,
         alt=<ALT>m,
         speed=<SPEED>m/s,
         dirMove=<DIR_MOVE>,
         dirComp=<DIR_COMP>,
         vAcc=<V_ACC>m,
         hAcc=<H_ACC>m,
         sat=<SAT>
    -truncate GPS_READING_EPOCH_MILLIS to GPS_READING_EPOCH_S
    -include only <GPS_READING>s where:
      START_EPOCH_S <= GPS_READING_EPOCH_S <= END_EPOCH_S
    -print each <GPS_READING>, formatted:
      <DATE_FMT> : lat=<LAT> : lon=<LON>
";

my $START_CHECK_POINT = {name=>"start", dist=>0, targetDist=>undef};

my $COURSES = {
  belmont => {
    locations => {
      NE_BRIDGE     => {lat=>'40.738874', lon=>'-73.343685'},
      STATE_PARK_HQ => {lat=>'40.734507', lon=>'-73.344047'},
      SWAN_COVE_SW  => {lat=>'40.734878', lon=>'-73.341137'},
    },

    checkPointsArr => [
      ### NAME      DIST  LOC_NAME
      [qw(Start     0.00  NE_BRIDGE)],
      [qw(Lap01  1885.96  NE_BRIDGE)],
      [qw(Lap02  1885.96  NE_BRIDGE)],
      [qw(5K     1228.08  SWAN_COVE_SW)],
      [qw(Lap03   657.88  NE_BRIDGE)],
      [qw(Lap04  1885.96  NE_BRIDGE)],
      [qw(Lap05  1885.96  NE_BRIDGE)],
      [qw(10K     570.20  STATE_PARK_HQ)],
      [qw(Lap06  1315.76  NE_BRIDGE)],
      [qw(Lap07  1885.96  NE_BRIDGE)],
      [qw(Lap08  1885.96  NE_BRIDGE)],
      [qw(Lap09  1885.96  NE_BRIDGE)],
      [qw(Lap10  1885.96  NE_BRIDGE)],
      [qw(Lap11  1885.96  NE_BRIDGE)],
      [qw(Lap12  1885.96  NE_BRIDGE)],
      [qw(Lap13  1885.96  NE_BRIDGE)],
    ],
  }
};

my $MODE_GET = "get";
my $MODE_KML = "kml";
my $MODE_COURSE = "course";
my $MODE_CHECKPOINT = "checkpoint";

sub main(@){
  my $mode = undef;
  my $startTimeStr = undef;
  my $endTimeStr = undef;
  my $courseName = undef;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^(-g|--get)$/){
      $mode = $MODE_GET;
    }elsif($arg =~ /^(-k|--kml)$/){
      $mode = $MODE_KML;
    }elsif($arg =~ /^(-c|--course|-w|--workout)$/){
      $mode = $MODE_COURSE;
    }elsif($arg =~ /^(--checkpoint|--check-point|--run|--race)$/){
      $mode = $MODE_CHECKPOINT;
    }elsif(defined $$COURSES{$arg} and not defined $courseName){
      $mode = $MODE_COURSE if not defined $mode;
      $courseName = $arg;
    }elsif(not defined $startTimeStr){
      $startTimeStr = $arg;
    }elsif(not defined $endTimeStr){
      $endTimeStr = $arg;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }
  $mode = $MODE_GET if not defined $mode;

  die "$USAGE\nERROR: missing START_TIME\n" if not defined $startTimeStr;
  if(not defined $endTimeStr){
    $endTimeStr = `date --iso=s`;
    chomp $endTimeStr
  }

  my $startEpoch = str2time($startTimeStr);
  my $endEpoch = str2time($endTimeStr);
  if(not defined $startEpoch or not defined $endEpoch){
    die "ERROR: date/time parsing failed for START_TIME/END_TIME\n";
  }

  my $startEpochMillis = int($startEpoch*1000.0 + 0.5);
  my $endEpochMillis = int($endEpoch*1000.0 + 0.5);

  if($mode eq $MODE_GET){
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);
    for my $gpsReading(@gpsReadings){
      printf "%s : lat=%9.6f : lon=%9.6f\n",
        $$gpsReading{dtmFmt}, $$gpsReading{lat}, $$gpsReading{lon};
    }
  }elsif($mode eq $MODE_KML){
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);
    my $name = time2str("gpsinfo_%Y_%m_%d_%H_%M_%S", $startEpoch);
    print formatKML($name, @gpsReadings);
  }elsif($mode eq $MODE_COURSE){
    die "$USAGE\nERROR: missing COURSE_NAME\n" if not defined $courseName;
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);

    my @checkPointGpsReadings = getCheckPointGpsReadings($courseName, @gpsReadings);
    if(@checkPointGpsReadings == 0){
      die "ERROR: no checkpoints reached for course=$courseName between $startTimeStr and $endTimeStr\n";
    }

    my @segments = parseCheckPointSegments(@checkPointGpsReadings);

    my $firstReading = $checkPointGpsReadings[0];
    my $lastReading = $checkPointGpsReadings[-1];

    my $gpsTotalDist = $$lastReading{courseProgressDist};
    my $gpsTotalDurMillis = $$lastReading{gpsReading}{epochMillis} - $$firstReading{gpsReading}{epochMillis};
    my $gpsTotalDurFracS = sprintf "%.2f", $gpsTotalDurMillis / 1000.0;

    my $targetDtmDurMillis = $endEpochMillis - $startEpochMillis;
    my $targetDtmDurFracS = sprintf "%.2f", $targetDtmDurMillis / 1000.0;
    if($gpsTotalDurFracS ne $targetDtmDurFracS){
      #check gps reading times within 0.01s of indicated start/end params
      print STDERR "\n\n\nWARNING: gps checkpoint duration total does not match START/END\n\n\n";
    }

    printf "GPS TOTAL: %s  %.2fm\n", $gpsTotalDurFracS, $gpsTotalDist;
    printf "TARGET DTM DUR: %s\n", $targetDtmDurFracS;
    for my $s(@segments){
      printf "segment: %-20s  %-20s  %s   %.2f\n",
        $$s{format},
        $$s{desc},
        formatHMS($$s{progDurMillis}/1000.0),
        $$s{progDist},
      ;
    }

    print "\n";
    printf "%s    %.2fmi\n",
      formatHMS($gpsTotalDurMillis/1000.0),
      $MILES_PER_KM*$gpsTotalDist/1000.0;
    print "\n\n";

    my $dtmYMD = time2str("%Y-%m-%d", $startEpoch);
    my $workoutID = $startEpoch;

    my $fmt = "#$dtmYMD\n";
    $fmt .= "#  $courseName\n";
    $fmt .= "##### gpsinfo calculated\n";
    $fmt .= "$workoutID.epoch = $startEpoch.000\n";
    $fmt .= "$workoutID.distance = " . sprintf("%.2f", $gpsTotalDist) . "\n";
    $fmt .= "$workoutID.duration = " . sprintf("%.2f", $gpsTotalDurMillis/1000.0) . "\n";
    $fmt .= "$workoutID.intervals = " . join(",", map {$$_{format}} @segments) . "\n";

    print $fmt;
  }elsif($mode eq $MODE_CHECKPOINT){
    die "$USAGE\nERROR: missing COURSE_NAME\n" if not defined $courseName;
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);

    my @checkPointGpsReadings = getCheckPointGpsReadings($courseName, @gpsReadings);
    if(@checkPointGpsReadings == 0){
      die "ERROR: no checkpoints reached for course=$courseName between $startTimeStr and $endTimeStr\n";
    }

    my @segments = parseCheckPointSegments(@checkPointGpsReadings);

    my $firstCheckPoint = $checkPointGpsReadings[0];
    my $curCheckPoint = $checkPointGpsReadings[-1];
    my $prevCheckPoint = $checkPointGpsReadings[-2];

    my $segmentDist = undef;
    my $segmentDurMillis = undef;
    my $segmentSpeedMPH = undef;
    if(defined $prevCheckPoint){
      $segmentDist = $$curCheckPoint{courseProgressDist} - $$prevCheckPoint{courseProgressDist};
      $segmentDurMillis = $$curCheckPoint{gpsReading}{epochMillis} - $$prevCheckPoint{gpsReading}{epochMillis};
      $segmentSpeedMPH = $segmentDurMillis > 0 ? ($segmentDist/1000.0)/($segmentDurMillis/1000/60/60)*$MILES_PER_KM : 0;
    }

    my $totalDist = $$curCheckPoint{courseProgressDist} - $$firstCheckPoint{courseProgressDist};
    my $totalDurMillis = $$curCheckPoint{gpsReading}{epochMillis} - $$firstCheckPoint{gpsReading}{epochMillis};
    my $totalSpeedMPH = $totalDurMillis > 0 ? ($totalDist/1000.0)/($totalDurMillis/1000/60/60)*$MILES_PER_KM : 0;

    printf "%s,%.1fkm,%.1f,%.1f\n",
      $$curCheckPoint{checkPoint}{name},
      $totalDist/1000.0,
      $segmentSpeedMPH,
      $totalSpeedMPH,
    ;
  }else{
    die "ERROR: unknown mode $mode\n";
  }
}

sub getGpsReadings($$){
  my ($startEpochMillis, $endEpochMillis) = @_;
  my @allGpsLogFiles = grep {-f $_} (
    glob("$GPSINFO_BAK_DIR/*.log*"),
    glob("$GPSINFO_LOG_DIR/*.log*"),
  );

  #sort by filename epoch
  my %logFilesByEpochMillis;
  for my $logFile(@allGpsLogFiles){
    if($logFile =~ /harbour-gpsinfo-(\d+)(?:_\w+)?\.log(?:\.\w+)?$/){
      my $epochMillis = $1;
      $logFilesByEpochMillis{$epochMillis} = $logFile;
    }
  }

  my @okLogFiles;
  my $includedMostRecentOlder = 0;
  for my $logEpochMillis(reverse sort keys %logFilesByEpochMillis){
    my $logFile = $logFilesByEpochMillis{$logEpochMillis};
    #include the last file /older/ than the start,
    #  plus all files after that that end before end
    if($logEpochMillis > $endEpochMillis){
      next;
    }
    push @okLogFiles, $logFile;
    if($logEpochMillis < $startEpochMillis){
      last;
    }
  }

  my $startEpoch = int($startEpochMillis/1000.0);
  my $endEpoch = int($endEpochMillis/1000.0);

  my @readings;
  for my $file(reverse @okLogFiles){
    my @lines;
    if($file =~ /\.gz$/){
      @lines = `zcat '$file'`;
    }elsif($file =~ /\.xz$/){
      @lines = `xzcat '$file'`;
    }elsif($file =~ /\.log$/){
      @lines = `cat '$file'`;
    }

    for my $line(@lines){
      if($line !~ /^(\d+),([^,]*),lat=(-?\d+\.\d+|\?*),lon=(-?\d+\.\d+|\?*),/){
        die "ERROR: malformed line in $file\n$line\n";
      }
      my ($epochMillis, $dtmFmt, $lat, $lon) = ($1, $2, $3, $4);
      next if $lat !~ /^-?\d+\.\d+$/ or $lon !~ /^-?\d+\.\d+$/;

      my $epoch = int($epochMillis/1000.0);
      if($startEpoch <= $epoch && $epoch <= $endEpoch){
        push @readings, {epochMillis=>$epochMillis, dtmFmt=>$dtmFmt, lat=>$lat, lon=>$lon};
      }
    }
  }
  return @readings;
}

sub getCheckPointGpsReadings($@){
  my ($courseName, @gpsReadings) = @_;

  my @checkPointGpsReadings;

  if(@gpsReadings == 0){
    return @checkPointGpsReadings;
  }

  my $firstReading = $gpsReadings[0];

  my $gis = GIS::Distance->new();

  my %completedTargets;

  my $courseProgressDist = 0;
  my @checkPoints = parseCourse($courseName);

  my $nextCheckPoint = shift @checkPoints;
  for(my $i=0; $i<@gpsReadings; $i++){
    my $gpsReading = $gpsReadings[$i];

    if(not defined $nextCheckPoint){
      last;
    }

    my $dist = $gis->distance(
      $$nextCheckPoint{lat}, $$nextCheckPoint{lon},
      $$gpsReading{lat}, $$gpsReading{lon}
    )->meters();

    if($dist < 10){
      #checkpoint reached

      my $localMinGpsReading = $gpsReading;
      my $minDist = $dist;
      my $isFirstEntry = $i == 0 ? 1 : 0;

      while($dist < 30 && $i < @gpsReadings){
        #skip all adjacent readings within 30m
        $i++;
        $gpsReading = $gpsReadings[$i];
        $dist = $gis->distance(
          $$nextCheckPoint{lat}, $$nextCheckPoint{lon},
          $$gpsReading{lat}, $$gpsReading{lon}
        )->meters();

        if($dist<$minDist and not $isFirstEntry){
          #if first checkpoint is at first entry, use first entry instead of closest entry
          $localMinGpsReading = $gpsReading;
          $minDist = $dist;
        }
      }

      $courseProgressDist += $$nextCheckPoint{dist};

      push @checkPointGpsReadings, {
        courseProgressDist=>$courseProgressDist,
        checkPoint=>$nextCheckPoint,
        gpsReading=>$localMinGpsReading,
      };

      $nextCheckPoint = shift @checkPoints;
    }
  }

  return @checkPointGpsReadings;
}

sub parseCourse($){
  my ($courseName) = @_;
  die "ERROR: unknown COURSE_NAME $courseName\n" if not defined $$COURSES{$courseName};

  my @checkPoints;
  my %locByName = %{$$COURSES{$courseName}{locations}};

  for my $entry(@{$$COURSES{$courseName}{checkPointsArr}}){
    if(@$entry != 3
      || $$entry[0] !~ /^\w+$/
      || $$entry[1] !~ /^(\d+|\d*\.\d+)$/
      || $$entry[2] !~ /^(\w+)$/
    ){
      die "ERROR: invalid checkpoint entry '@$entry' in course $courseName\n";
    }

    my ($checkPointName, $dist, $locName) = @$entry;
    my $loc = $locByName{$locName};
    if(not defined $loc){
      die "ERROR: invalid location name $locName in course $courseName\n";
    }
    push @checkPoints, {
      name           => $checkPointName,
      lat            => $$loc{lat},
      lon            => $$loc{lon},
      dist           => $dist,
    };
  }

  return @checkPoints;
}

sub parseCheckPointSegments(@){
  my @checkPointGpsReadings = @_;
  die "ERROR: empty checkpoint gps readings\n" if @checkPointGpsReadings == 0;
  my $firstReading = $checkPointGpsReadings[0];

  my @segments;
  for(my $i=0; $i<@checkPointGpsReadings; $i++){
    my $segmentStart = $checkPointGpsReadings[$i];
    my $segmentEnd = $i+1<@checkPointGpsReadings ? $checkPointGpsReadings[$i+1] : undef;
    if(defined $segmentStart and defined $segmentEnd){
      my $dist = $$segmentEnd{courseProgressDist} - $$segmentStart{courseProgressDist};
      my $durMillis = $$segmentEnd{gpsReading}{epochMillis} - $$segmentStart{gpsReading}{epochMillis};
      push @segments, {
        segmentDist      => $dist,
        segmentDurMillis => $durMillis,
        progDist         => $$segmentEnd{courseProgressDist} - $$firstReading{courseProgressDist},
        progDurMillis    => $$segmentEnd{gpsReading}{epochMillis} - $$firstReading{gpsReading}{epochMillis},
        desc             => "$$segmentStart{checkPoint}{name} => $$segmentEnd{checkPoint}{name}",
        format           => sprintf("%.2fs:%.2fm", $durMillis/1000.0, $dist),
      };
    }
  }
  return @segments;
}

sub formatKML($@){
  my ($name, @gpsReadings) = @_;

  my $kml = ""
    . "<?xml version=\"1.0\" encoding=\"utf-8\" ?>\n"
    . "<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n"
    . "<Document id=\"root_doc\">\n"
    . "<Schema name=\"$name\" id=\"$name\">\n"
    . "  <SimpleField name=\"ID\" type=\"string\"></SimpleField>\n"
    . "</Schema>\n"
    . "<Folder>\n"
    . "  <name>$name</name>\n"
  ;
  my $index = 1;
  for my $gpsReading(@gpsReadings){
    $kml .= ""
      . "  <Placemark id=\"$name.$index\">\n"
      . "    <ExtendedData>\n"
      . "      <SchemaData schemaUrl=\"#$name\">\n"
      . "        <SimpleData name=\"ID\">$$gpsReading{epochMillis}</SimpleData>\n"
      . "      </SchemaData>\n"
      . "    </ExtendedData>\n"
      . "    <Point><coordinates>$$gpsReading{lon},$$gpsReading{lat}</coordinates></Point>\n"
      . "  </Placemark>\n"
    ;
    $index++;
  }
  $kml .= ""
    . "</Folder>\n"
    . "</Document>\n"
    . "</kml>\n"
  ;

  return $kml;
}

sub formatHMS($){
  my ($t) = @_;
  my $h = int($t / 60.0 / 60.0);
  my $m = int($t / 60.0) % 60;
  my $s = int($t) % 60;
  return sprintf("%dh%02dm%02ds", $h, $m, $s);
}

&main(@ARGV);
