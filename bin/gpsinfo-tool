my $MODE_GET = "get";
my $MODE_KML = "kml";
my $MODE_COURSE_KML = "course-kml";
my $MODE_COURSE = "course";
my $MODE_CHECKPOINT = "checkpoint";

sub main(@){
  my $opts = {
    allCheckpoints => 0,
  };
  my $mode = undef;
  my $startTimeStr = undef;
  my $endTimeStr = undef;
  my $courseName = undef;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^(-g|--get)$/){
      $mode = $MODE_GET;
    }elsif($arg =~ /^(-k|--kml)$/){
      $mode = $MODE_KML;
    }elsif($arg =~ /^(--course-kml)$/){
      $mode = $MODE_COURSE_KML;
    }elsif($arg =~ /^(-c|--course|-w|--workout)$/){
      $mode = $MODE_COURSE;
    }elsif($arg =~ /^(--checkpoint|--check-point|--run|--race)$/){
      $mode = $MODE_CHECKPOINT;
    }elsif($arg =~ /^(--all|--all-checkpoints)$/){
      $$opts{allCheckpoints} = 1;
    }elsif(defined $$COURSES{$arg} and not defined $courseName){
      $mode = $MODE_COURSE if not defined $mode;
      $courseName = $arg;
    }elsif(not defined $startTimeStr){
      $startTimeStr = $arg;
    }elsif(not defined $endTimeStr){
      $endTimeStr = $arg;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }
  $mode = $MODE_GET if not defined $mode;

  my $startEpoch = undef;
  my $endEpoch = undef;
  my $startEpochMillis = undef;
  my $endEpochMillis = undef;
  if($mode =~ /^($MODE_GET|$MODE_KML|$MODE_COURSE|$MODE_CHECKPOINT)$/){
    die "$USAGE\nERROR: missing START_TIME\n" if not defined $startTimeStr;

    if(not defined $endTimeStr){
      $endTimeStr = `date --iso=s`;
      chomp $endTimeStr
    }

    $startEpoch = str2time($startTimeStr);
    $endEpoch = str2time($endTimeStr);
    if(not defined $startEpoch or not defined $endEpoch){
      die "ERROR: date/time parsing failed for START_TIME/END_TIME\n";
    }

    $startEpochMillis = int($startEpoch*1000.0 + 0.5);
    $endEpochMillis = int($endEpoch*1000.0 + 0.5);
  }

  if($mode eq $MODE_GET){
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);
    for my $gpsReading(@gpsReadings){
      printf "%s : lat=%9.6f : lon=%9.6f\n",
        $$gpsReading{dtmFmt}, $$gpsReading{lat}, $$gpsReading{lon};
    }
  }elsif($mode eq $MODE_KML){
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);
    my $documentName = time2str("gpsinfo_%Y_%m_%d_%H_%M_%S", $startEpoch);
    print formatKMLGpsReadings($documentName, @gpsReadings);
  }elsif($mode eq $MODE_COURSE_KML){
    die "$USAGE\nERROR: missing COURSE_NAME\n" if not defined $courseName;
    print formatKMLCourse($courseName);
  }elsif($mode eq $MODE_COURSE){
    die "$USAGE\nERROR: missing COURSE_NAME\n" if not defined $courseName;
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);

    my @checkPointGpsReadings = getCheckPointGpsReadings($courseName, @gpsReadings);
    if(@checkPointGpsReadings == 0){
      die "ERROR: no checkpoints reached for course=$courseName between $startTimeStr and $endTimeStr\n";
    }

    my @segments = parseCheckPointSegments($opts, @checkPointGpsReadings);

    my $firstReading = $checkPointGpsReadings[0];
    my $lastReading = $checkPointGpsReadings[-1];

    my $gpsTotalDist = $$lastReading{courseProgressDist};
    my $gpsTotalDurMillis = $$lastReading{gpsReading}{epochMillis} - $$firstReading{gpsReading}{epochMillis};
    my $gpsTotalDurFracS = sprintf "%.2f", $gpsTotalDurMillis / 1000.0;

    my $targetDtmDurMillis = $endEpochMillis - $startEpochMillis;
    my $targetDtmDurFracS = sprintf "%.2f", $targetDtmDurMillis / 1000.0;
    if($gpsTotalDurFracS ne $targetDtmDurFracS){
      #check gps reading times within 0.01s of indicated start/end params
      print STDERR "\n\n\nWARNING: gps checkpoint duration total does not match START/END\n\n\n";
    }

    printf "GPS TOTAL: %s  %.2fm\n", $gpsTotalDurFracS, $gpsTotalDist;
    printf "TARGET DTM DUR: %s\n", $targetDtmDurFracS;
    printf "TIME: %s - %s\n",
      time2str('%H:%M:%S', ($$firstReading{gpsReading}{epochMillis}/1000.0)),
      time2str('%H:%M:%S', ($$lastReading{gpsReading}{epochMillis}/1000.0)),
    ;
    for my $s(@segments){
      my $mph = ($$s{segmentDist}/1000.0*$MILES_PER_KM)/($$s{segmentDurMillis}/1000.0/60/60);
      printf "segment: %-17s|%4.1fmph|%s|%9s|%9.2f|%s\n",
        $$s{format},
        $mph,
        time2str('%H:%M:%S', ($$s{endEpochMillis}/1000.0)),
        formatDurHMS($$s{progDurMillis}/1000.0),
        $$s{progDist},
        $$s{desc},
      ;
    }

    print "\n";
    printf "%s    %.2fmi\n",
      formatDurHMS($gpsTotalDurMillis/1000.0),
      $MILES_PER_KM*$gpsTotalDist/1000.0;
    print "\n\n";

    my $dtmYMD = time2str("%Y-%m-%d", $startEpoch);
    my $workoutID = $startEpoch;

    my $fmt = "#$dtmYMD\n";
    $fmt .= "#  $courseName\n";
    $fmt .= "##### gpsinfo calculated\n";
    $fmt .= "$workoutID.epoch = $startEpoch.000\n";
    $fmt .= "$workoutID.distance = " . sprintf("%.2f", $gpsTotalDist) . "\n";
    $fmt .= "$workoutID.duration = " . sprintf("%.2f", $gpsTotalDurMillis/1000.0) . "\n";
    $fmt .= "$workoutID.intervals = " . join(",", map {$$_{format}} @segments) . "\n";

    print $fmt;
  }elsif($mode eq $MODE_CHECKPOINT){
    die "$USAGE\nERROR: missing COURSE_NAME\n" if not defined $courseName;
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);

    my @checkPointGpsReadings = getCheckPointGpsReadings($courseName, @gpsReadings);
    if(@checkPointGpsReadings == 0){
      die "ERROR: no checkpoints reached for course=$courseName between $startTimeStr and $endTimeStr\n";
    }

    my $firstCheckPoint = $checkPointGpsReadings[0];
    my $curCheckPoint = $checkPointGpsReadings[-1];
    my $prevCheckPoint = $checkPointGpsReadings[-2];

    my $segmentDist = 0;
    my $segmentDurMillis = 0;
    my $segmentSpeedMPH = 0;
    if(defined $prevCheckPoint){
      $segmentDist = $$curCheckPoint{courseProgressDist} - $$prevCheckPoint{courseProgressDist};
      $segmentDurMillis = $$curCheckPoint{gpsReading}{epochMillis} - $$prevCheckPoint{gpsReading}{epochMillis};
      $segmentSpeedMPH = $segmentDurMillis > 0 ? ($segmentDist/1000.0)/($segmentDurMillis/1000/60/60)*$MILES_PER_KM : 0;
    }

    my $totalDist = $$curCheckPoint{courseProgressDist} - $$firstCheckPoint{courseProgressDist};
    my $totalDurMillis = $$curCheckPoint{gpsReading}{epochMillis} - $$firstCheckPoint{gpsReading}{epochMillis};
    my $totalSpeedMPH = $totalDurMillis > 0 ? ($totalDist/1000.0)/($totalDurMillis/1000/60/60)*$MILES_PER_KM : 0;

    printf "%s,%s,%.1fkm,%.1fmi,%.1fmph,%.1fmph\n",
      $$curCheckPoint{checkPoint}{name},
      $$curCheckPoint{checkPoint}{priority},
      $totalDist/1000.0,
      $totalDist/1000.0*$MILES_PER_KM,
      $segmentSpeedMPH,
      $totalSpeedMPH,
    ;
  }else{
    die "ERROR: unknown mode $mode\n";
  }
}

sub getGpsReadings($$){
  my ($startEpochMillis, $endEpochMillis) = @_;
  my @allGpsLogFiles = grep {-f $_} (
    glob("$GPSINFO_BAK_DIR/*.log*"),
    glob("$GPSINFO_LOG_DIR/*.log*"),
  );

  #sort by filename epoch
  my %logFilesByEpochMillis;
  for my $logFile(@allGpsLogFiles){
    if($logFile =~ /harbour-gpsinfo-(\d+)(?:_\w+)?\.log(?:\.\w+)?$/){
      my $epochMillis = $1;
      $logFilesByEpochMillis{$epochMillis} = $logFile;
    }
  }

  my @okLogFiles;
  my $includedMostRecentOlder = 0;
  for my $logEpochMillis(reverse sort keys %logFilesByEpochMillis){
    my $logFile = $logFilesByEpochMillis{$logEpochMillis};
    #include the last file /older/ than the start,
    #  plus all files after that that end before end
    if($logEpochMillis > $endEpochMillis){
      next;
    }
    push @okLogFiles, $logFile;
    if($logEpochMillis < $startEpochMillis){
      last;
    }
  }

  my $startEpoch = int($startEpochMillis/1000.0);
  my $endEpoch = int($endEpochMillis/1000.0);

  my @readings;
  for my $file(reverse @okLogFiles){
    my @lines;
    if($file =~ /\.gz$/){
      @lines = `zcat '$file'`;
    }elsif($file =~ /\.xz$/){
      @lines = `xzcat '$file'`;
    }elsif($file =~ /\.log$/){
      @lines = `cat '$file'`;
    }

    for my $line(@lines){
      if($line !~ /^(\d+),([^,]*),lat=(-?\d+\.\d+|\?*),lon=(-?\d+\.\d+|\?*),/){
        die "ERROR: malformed line in $file\n$line\n";
      }
      my ($epochMillis, $dtmFmt, $lat, $lon) = ($1, $2, $3, $4);
      next if $lat !~ /^-?\d+\.\d+$/ or $lon !~ /^-?\d+\.\d+$/;

      my $epoch = int($epochMillis/1000.0);
      if($startEpoch <= $epoch && $epoch <= $endEpoch){
        push @readings, {epochMillis=>$epochMillis, dtmFmt=>$dtmFmt, lat=>$lat, lon=>$lon};
      }
    }
  }
  return @readings;
}

sub getCheckPointGpsReadings($@){
  my ($courseName, @gpsReadings) = @_;

  my @checkPointGpsReadings;

  if(@gpsReadings == 0){
    return @checkPointGpsReadings;
  }

  my $firstReading = $gpsReadings[0];

  my $gis = GIS::Distance->new();

  my %completedTargets;

  my $courseProgressDist = 0;
  my @checkPoints = parseCourse($courseName);

  my $startCPIdx = 0;
  for(my $i=0; $i<@gpsReadings; $i++){
    my $gpsReading = $gpsReadings[$i];

    last if $startCPIdx >= @checkPoints;

    my $checkPoint = undef;
    for(my $endCPIdx=$startCPIdx; $endCPIdx<@checkPoints; $endCPIdx++){
      if($endCPIdx > $startCPIdx + $MAX_SKIPPED_CHECKPOINTS){
        #only permit 'skipping' up to MAX_SKIPPED_CHECKPOINTS checkpoints
        last;
      }
      my $curCheckPoint = $checkPoints[$endCPIdx];

      if(isCheckPointAchieved($gis, $gpsReading, $curCheckPoint)){
        my @cps = @checkPoints[$startCPIdx..$endCPIdx];

        #combine any skipped checkpoints into the achieved checkpoint
        $checkPoint = combineCheckPoints(@checkPoints[$startCPIdx..$endCPIdx]);

        $startCPIdx = $endCPIdx + 1;
        last;
      }
    }

    if(defined $checkPoint){
      #one of the next (MAX_SKIPPED_CHECKPOINTS+1) checkpoints achieved

      my $dist = $gis->distance(
        $$checkPoint{lat}, $$checkPoint{lon},
        $$gpsReading{lat}, $$gpsReading{lon}
      )->meters();

      my $localMinGpsReading = $gpsReading;
      my $minDist = $dist;
      my $isFirstEntry = $i == 0 ? 1 : 0;

      while($dist < 30 && $i+1 < @gpsReadings){
        #skip all adjacent readings within 30m
        $i++;
        $gpsReading = $gpsReadings[$i];
        $dist = $gis->distance(
          $$checkPoint{lat}, $$checkPoint{lon},
          $$gpsReading{lat}, $$gpsReading{lon}
        )->meters();

        if($dist<$minDist and not $isFirstEntry){
          #if first checkpoint is at first entry, use first entry instead of closest entry
          $localMinGpsReading = $gpsReading;
          $minDist = $dist;
        }
      }

      $courseProgressDist += $$checkPoint{dist};

      push @checkPointGpsReadings, {
        courseProgressDist=>$courseProgressDist,
        checkPoint=>$checkPoint,
        gpsReading=>$localMinGpsReading,
      };
    }
  }

  return @checkPointGpsReadings;
}

sub isCheckPointAchieved($$$){
  my ($gis, $gpsReading, $checkPoint) = @_;

  my $dist = $gis->distance(
    $$checkPoint{lat}, $$checkPoint{lon},
    $$gpsReading{lat}, $$gpsReading{lon}
  )->meters();

  if($dist < 10){
    return 1;
  }else{
    return 0;
  }
}

sub combineCheckPoints(@){
  my (@checkPoints) = @_;
  if(@checkPoints == 0){
    return undef;
  }else{
    my $lastCheckPoint = $checkPoints[-1];
    my $dist = 0;
    my $priority = $PRIORITY_LOW;
    my $isSegmentSplit = 0;
    for my $checkPoint(@checkPoints){
      $dist += $$checkPoint{dist};
      if($PRIORITY_RANK{$$checkPoint{priority}} > $PRIORITY_RANK{$priority}){
        $priority = $$checkPoint{priority};
      }
      $isSegmentSplit = 1 if $$checkPoint{isSegmentSplit} == 1;
    }

    return {
      name           => $$lastCheckPoint{name},
      lat            => $$lastCheckPoint{lat},
      lon            => $$lastCheckPoint{lon},
      rect           => $$lastCheckPoint{rect},
      dist           => $dist,
      priority       => $priority,
      isSegmentSplit => $isSegmentSplit,
    };
  }
}

sub parseCourse($){
  my ($courseName) = @_;
  die "ERROR: unknown COURSE_NAME $courseName\n" if not defined $$COURSES{$courseName};

  my @checkPoints;
  my %locByName = %{$$COURSES{$courseName}{locations}};
  my %lapTypes = %{$$COURSES{$courseName}{lapTypes}};

  for my $lap(@{$$COURSES{$courseName}{checkPointLaps}}){
    my $lapType = $$lap{lapType};
    my $lapName = $$lap{lapName};

    die "ERROR: unknown lap type $lapType\n" if not defined $lapTypes{$lapType};

    for my $entry(@{$lapTypes{$lapType}}){
      if(@$entry != 5
        || $$entry[0] !~ /^\S+$/
        || $$entry[1] !~ /^(\d+|\d*\.\d+)$/
        || $$entry[2] !~ /^($PRIORITY_LOW|$PRIORITY_MED|$PRIORITY_HIGH)$/
        || $$entry[3] !~ /^(0|1)$/
        || $$entry[4] !~ /^(\w+)$/
      ){
        die "ERROR: invalid checkpoint entry '@$entry' in LAP_TYPE $lapType\n";
      }

      my ($checkPointNameTemplate, $dist, $priority, $isSegmentSplit, $locName) = @$entry;
      my $loc = $locByName{$locName};
      if(not defined $loc){
        die "ERROR: invalid location name $locName in course $courseName\n";
      }

      my $checkPointName = $checkPointNameTemplate;
      $checkPointName =~ s/\$\{lapName\}/$lapName/g;

      push @checkPoints, {
        name           => $checkPointName,
        lat            => $$loc{lat},
        lon            => $$loc{lon},
        rect           => $$loc{rect},
        dist           => $dist,
        priority       => $priority,
        isSegmentSplit => $isSegmentSplit,
      };
    }
  }

  return @checkPoints;
}

sub parseCheckPointSegments($@){
  my ($opts, @checkPointGpsReadings) = @_;
  die "ERROR: empty checkpoint gps readings\n" if @checkPointGpsReadings == 0;
  my $firstReading = $checkPointGpsReadings[0];

  my @segments;
  my $i=0;
  while($i+1 < @checkPointGpsReadings){
    my $segmentStartIdx = $i;
    my $segmentEndIdx = $i+1;

    my $segmentStart = $checkPointGpsReadings[$segmentStartIdx];
    my $segmentEnd = $checkPointGpsReadings[$segmentEndIdx];
    while($segmentEndIdx+1 < @checkPointGpsReadings){
      if($$opts{allCheckpoints} or $$segmentEnd{checkPoint}{isSegmentSplit}){
        last;
      }else{
        $segmentEndIdx++;
        $segmentEnd = $checkPointGpsReadings[$segmentEndIdx];
      }
    }

    my $dist = $$segmentEnd{courseProgressDist} - $$segmentStart{courseProgressDist};
    my $durMillis = $$segmentEnd{gpsReading}{epochMillis} - $$segmentStart{gpsReading}{epochMillis};
    push @segments, {
      segmentDist      => $dist,
      segmentDurMillis => $durMillis,
      startEpochMillis => $$segmentStart{gpsReading}{epochMillis},
      endEpochMillis   => $$segmentEnd{gpsReading}{epochMillis},
      progDist         => $$segmentEnd{courseProgressDist} - $$firstReading{courseProgressDist},
      progDurMillis    => $$segmentEnd{gpsReading}{epochMillis} - $$firstReading{gpsReading}{epochMillis},
      desc             => "$$segmentStart{checkPoint}{name} => $$segmentEnd{checkPoint}{name}",
      format           => sprintf("%.2fs:%.2fm", $durMillis/1000.0, $dist),
    };

    $i = $segmentEndIdx;
  }
  return @segments;
}

sub formatKMLGpsReadings($@){
  my ($documentName, @gpsReadings) = @_;

  my @points = map {
    {name=>$$_{dtmFmt}, id=>$$_{epochMillis}, lat=>$$_{lat}, lon=>$$_{lon}}
  } @gpsReadings;

  return formatKMLPointsPolygons($documentName, [@points], []);
}

sub formatKMLCourse($){
  my ($courseName) = @_;

  my %locations = %{$$COURSES{$courseName}{locations}};

  my $documentName = "course-$courseName";
  my @points;
  my @polygons;
  for my $name(sort keys %locations){
    push @points, {
      name=>$name, id=>$name, lat=>$locations{$name}{lat}, lon=>$locations{$name}{lon}
    };
    push @polygons, {
      name=>"rect_$name", id=>"rect_$name", points=>$locations{$name}{rect}
    };
  }

  return formatKMLPointsPolygons($documentName, [@points], [@polygons]);
}

sub formatKMLPointsPolygons($$$){
  my ($documentName, $points, $polygons) = @_;

  my $kml = ""
    . "<?xml version=\"1.0\" encoding=\"utf-8\" ?>\n"
    . "<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n"
    . "<Document id=\"root_doc\">\n"
    . "<Schema name=\"$documentName\" id=\"$documentName\">\n"
    . "  <SimpleField name=\"ID\" type=\"string\"></SimpleField>\n"
    . "</Schema>\n"
    . "<Folder>\n"
    . "  <name>$documentName</name>\n"
  ;

  my $index = 1;

  for my $pt(@$points){
    $kml .= ""
      . "  <Placemark id=\"$documentName.$index\">\n"
      . "    <name>$$pt{name}</name>\n"
      . "    <ExtendedData>\n"
      . "      <SchemaData schemaUrl=\"#$documentName\">\n"
      . "        <SimpleData name=\"ID\">$$pt{id}</SimpleData>\n"
      . "      </SchemaData>\n"
      . "    </ExtendedData>\n"
      . "    <Point><coordinates>$$pt{lon},$$pt{lat}</coordinates></Point>\n"
      . "  </Placemark>\n"
    ;
    $index++;
  }
  for my $poly(@$polygons){
    my @coords;
    for my $pt(@{$$poly{points}}){
      push @coords, "$$pt{lon},$$pt{lat}";
    }
    my $coordsFmt = join " ", @coords;
    $kml .= ""
      . "  <Placemark id=\"$documentName.$index\">\n"
      . "    <name>$$poly{name}</name>\n"
      . "    <ExtendedData>\n"
      . "      <SchemaData schemaUrl=\"#$documentName\">\n"
      . "        <SimpleData name=\"ID\">$$poly{id}</SimpleData>\n"
      . "      </SchemaData>\n"
      . "    </ExtendedData>\n"
      . "    <Polygon>\n"
      . "      <outerBoundaryIs><LinearRing><coordinates>\n"
      . "      $coordsFmt\n"
      . "      </coordinates></LinearRing></outerBoundaryIs>\n"
      . "    </Polygon>\n"
      . "  </Placemark>\n"
    ;
    $index++;
  }
  $kml .= ""
    . "</Folder>\n"
    . "</Document>\n"
    . "</kml>\n"
  ;

  return $kml;
}

sub formatDurHMS($){
  my ($t) = @_;
  my $h = int($t / 60.0 / 60.0);
  my $m = int($t / 60.0) % 60;
  my $s = int($t) % 60;
  return sprintf("%dh%02dm%02ds", $h, $m, $s);
}

sub rectLatLon(@){
  my (@latLonStrs) = @_;
  my $rect = [];
  for my $latLonStr(@latLonStrs){
    if($latLonStr !~ /^(-?\d+\.\d+),(-?\d+\.\d+)$/){
      die "ERROR: malformed lat/lon pair '$latLonStr'\n";
    }
    push @$rect, {lat=>"$1", lon=>"$2"};
  }
  return $rect;
}

&main(@ARGV);
