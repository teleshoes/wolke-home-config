#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);
use Date::Format qw(time2str);
use Date::Parse qw(str2time);

use GIS::Distance;

sub getGpsReadings($$);
sub getCheckPointGpsReadings($@);
sub isCheckPointAchieved($$$);
sub combineCheckPoints(@);
sub parseCourse($);
sub parseCheckPointSegments($@);
sub formatKMLGpsReadings($@);
sub formatKMLCourse($);
sub formatKMLPointsPolygons($$$);
sub formatDurHMS($);
sub rectLatLon(@);

my $EXEC = basename $0;

my $GPSINFO_BAK_DIR = "$ENV{HOME}/Code/sx/backup/backup-gpsinfo";
my $GPSINFO_LOG_DIR = "$ENV{HOME}/.cache/harbour-gpsinfo/harbour-gpsinfo";

my $MILES_PER_KM = 0.62137119;

my $MAX_SKIPPED_CHECKPOINTS = 2;

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC [OPTS] --kml START_TIME [END_TIME]
    -get <GPS_READING>s as in:
      $EXEC --get START_TIME END_TIME
    -format as KML and print
      -each GPS_READING is a <Placemark>
      -ID field is GPS_READING_EPOCH_MILLIS

  $EXEC [OPTS] --course-kml COURSE_NAME
    -print the checkpoint locations for a course as KML

  $EXEC [OPTS] COURSE_NAME START_TIME [END_TIME]
  $EXEC [OPTS] -c|--course COURSE_NAME START_TIME [END_TIME]
  $EXEC [OPTS] -w|--workout COURSE_NAME START_TIME [END_TIME]
    -get <GPS_READING>s as in:
      $EXEC --get START_TIME END_TIME
    -for each GPS_READING:
      -check if each <GPS_READING> is at or near the next few CHECK_POINTs
        NOTE: -each CHECK_POINT is reached at most once, and in order
              -up to $MAX_SKIPPED_CHECKPOINTS can be 'skipped', if the next CHECK_POINT is acheived
              -skipped CHECK_POINTS are assumed to also be achieved on the way
              -skipped CHECK_POINTS will not be listed separately, but will have their distance combined
      -calculate the DIST as the haversine distance in meters to next <CHECK_POINT>s
      -if DIST is < 10m for one of the next <CHECK_POINT>s:
        -combine the (up to $MAX_SKIPPED_CHECKPOINTS) 'skipped' CHECK_POINTS into the achieved CHECK_POINT
          -add the CHECK_POINT.DISTANCE for the skipped one or two <CHECK_POINT>s to the close CHECK_POINT
          -omit the skipped <CHECK_POINT>s
        -find the smallest DIST adjacent GPS_READING, and use that as the CHECK_POINT_GPS_READING
        -add the distance for that CHECK_POINT to the CURRENT_DIST_SUM
        -if CHECK_POINT is marked as isSegmentSplit (or is the last achieved CHECK_POINT):
          -include CHECK_POINT_GPS_READING as a SEGMENT_CHECK_POINT_GPS_READING
          NOTE: see --all-checkpoints
    -for each SEGMENT_CHECK_POINT_GPS_READING:
      -calculate the <SEGMENT_DISTANCE> since previous SEGMENT_CHECK_POINT_GPS_READING
      -calculate the <SEGMENT_DURATION> since previous SEGMENT_CHECK_POINT_GPS_READING
      -format SEGMENT_FMT as <SEGMENT_DURATION>s:<SEGMENT_DISTANCE>m
    -format summary of course distance/duration/segments
    -format workout with total distance, total duration, and segments

  $EXEC [OPTS] --checkpoint|--check-point|--run|--race COURSE_NAME START_TIME [END_TIME]
    -get all <CHECK_POINT_GPS_READING>s as in:
      $EXEC --course COURSE_NAME <START_TIME> \"\$(date)\"
    -use the oldest CHECK_POINT_GPS_READING as FIRST_CHECK_POINT
    -use the most-recent CHECK_POINT_GPS_READING as CUR_CHECK_POINT
    -use the second-most-recent CHECK_POINT_GPS_READING as PREV_CHECK_POINT
    -calculate SEGMENT_DIST as the distance between prev and cur:
      CUR_CHECK_POINT.DISTANCE
    -calculate SEGMENT_DUR_MILLIS as elapsed millis between prev and cur:
      CUR_CHECK_POINT.GPS_READING_EPOCH_MILLIS - PREV_CHECK_POINT.GPS_READING_EPOCH_MILLIS
    -calculate SEGMENT_SPEED_MPH as
      (SEGMENT_DIST/1000) / (SEGMENT_DUR_MILLIS/1000/60/60) * $MILES_PER_KM
    -calculate TOTAL_DIST as the dist from FIRST_CHECK_POINT to CUR_CHECK_POINT
    -calculate TOTAL_DUR_MILLIS as elapsed millis between FIRST_CHECK_POINT and CUR_CHECK_POINT
    -calculate TOTAL_SPEED_MPH as
      (TOTAL_DIST/1000) / (TOTAL_DUR_MILLIS/1000/60/60) * $MILES_PER_KM
    -calculate TOTAL_DIST_KM as TOTAL_DIST/1000
    -use <CUR_CHECK_POINT.PRIORITY> as <PRIORITY>
    -use <CUR_CHECK_POINT.NAME> as <CHECK_POINT_NAME>
    -print:
      <CHECK_POINT_NAME>,<PRIORITY>,<TOTAL_DIST_KM>,<SEGMENT_SPEED_MPH>mph,<TOTAL_SPEED_MPH>mph

  $EXEC [OPTS] START_TIME [END_TIME]
  $EXEC [OPTS] -g|--get START_TIME [END_TIME]
    -if not given, use current date/time for END_TIME
    -parse date range as seconds since epoch:
      -parse START_TIME as a date format string into START_EPOCH_S
      -parse END_TIME as a date format string into END_EPOCH_S
    -list gpsinfo csv <LOG_FILE>s:
      $GPSINFO_BAK_DIR/harbour-gpsinfo-<LOG_EPOCH_MILLIS>*.log*
      $GPSINFO_LOG_DIR/harbour-gpsinfo-<LOG_EPOCH_MILLIS>*.log*
    -get <MATCHING_LOG_FILE>s:
      -for each LOG_FILE:
        -truncate LOG_EPOCH_MILLIS to LOG_EPOCH_S (ignore millis)
        -include the *most recent* LOG_FILE where:
            LOG_EPOCH_S <= START_EPOCH_S
        -include all LOG_FILEs where:
            START_EPOCH_S <= LOG_EPOCH_S <= END_EPOCH_S
    -parse each GPS_READING csv row in each MATCHING_LOG_FILE, decompressing if necessary
       -format of each GPS_READING:
         <GPS_READING_EPOCH_MILLIS>,
         <DATE_FMT>,
         lat=<LAT>,lon=<LON>,
         alt=<ALT>m,
         speed=<SPEED>m/s,
         dirMove=<DIR_MOVE>,
         dirComp=<DIR_COMP>,
         vAcc=<V_ACC>m,
         hAcc=<H_ACC>m,
         sat=<SAT>
    -truncate GPS_READING_EPOCH_MILLIS to GPS_READING_EPOCH_S
    -include only <GPS_READING>s where:
      START_EPOCH_S <= GPS_READING_EPOCH_S <= END_EPOCH_S
    -print each <GPS_READING>, formatted:
      <DATE_FMT> : lat=<LAT> : lon=<LON>

  OPTS
    --all | --all-checkpoints
      ignore is-segment-split and always split segments at all checkpoints
";

my $PRIORITY_LOW = "LOW";
