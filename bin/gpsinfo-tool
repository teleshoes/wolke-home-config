#!/usr/bin/perl
use strict;
use warnings;
use feature 'try';
use File::Basename qw(basename);
use Date::Format qw(time2str);
use Date::Parse qw(str2time);
use List::Util qw(sum);
use YAML::PP;

use GIS::Distance;
use Math::Polygon;

sub getGpsReadings($$);
sub ensureCalcGpsReadingsDistSpeed(@);
sub calcSpeedMPH(@);
sub calcSpeedMPerS(@);
sub detectCourseStartForGpsReadings($@);
sub getCheckPointGpsReadings($$@);
sub combineCheckPoints(@);
sub parseCourseConfigYaml();
sub parseCheckPointSegments($@);
sub formatKMLGpsReadings($@);
sub formatKMLCourse($);
sub formatKMLPointsPolygons($$$);
sub formatDurHMS($);
sub ensureCoursePolygonObj($);
sub getPolygonObj($);
sub isPointInPolygonObj($$);
sub parseLatLon($);
sub isHash($);
sub isArr($);

my $EXEC = basename $0;

my $CONFIG_DIR = "$ENV{HOME}/.config/gpsinfo-tool";

my $GPSINFO_BAK_DIR = "$ENV{HOME}/Code/sx/backup/backup-gpsinfo";
my $GPSINFO_LOG_DIR = "$ENV{HOME}/.cache/harbour-gpsinfo/harbour-gpsinfo";

my $MILES_PER_KM = 0.62137119;

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC [OPTS] --kml START_TIME [END_TIME]
    -get <GPS_READING>s as in:
      $EXEC --get START_TIME END_TIME
    -format as KML and print
      -each GPS_READING is a <Placemark>
      -ID field is GPS_READING_EPOCH_MILLIS

  $EXEC [OPTS] --course-kml COURSE_NAME
    -print the checkpoint locations for a course as KML

  $EXEC [OPTS] COURSE_NAME START_TIME [END_TIME]
  $EXEC [OPTS] -c|--course COURSE_NAME START_TIME [END_TIME]
  $EXEC [OPTS] -w|--workout COURSE_NAME START_TIME [END_TIME]
    -get <GPS_READING>s as in:
      $EXEC --get START_TIME END_TIME
    -re-calculate START_TIME and END_TIME if --detect is given
    -for each GPS_READING:
      -check if each <GPS_READING> is at or near the next CHECK_POINT (or next few CHECK_POINTS)
        -optionally skip over up to MAX_SKIPPED_CHECKPOINTS, see --max-skip (default=0, never skip)
        -each CHECK_POINT is reached at most once, and in order
      -check if <GPS_READING> within the bounding polygon for one of the next <CHECK_POINT>(s):
        -if <GPS_READING> is not within the polygon for the <CHECK_POINT>(s), skip <GPS_READING>
        -if a <CHECK_POINT> is achieved:
          -if --max-skip is given:
            -combine the (up to <MAX_SKIPPED_CHECKPOINTS>) <SKIPPED_CHECK_POINT>s into achieved <CHECK_POINT>
          -select closest GPS_READING
            -gather all adjacent <GPS_READING>s that are also within the <CHECK_POINT> polygon
            -calculate the DIST as the haversine distance in meters to <CHECK_POINT>
            -find the smallest DIST in this set, and use that as the CHECK_POINT_GPS_READING
            -skip all other <GPS_READING>s within the <CHECK_POINT> polygon
        -add the distance for that CHECK_POINT to the CURRENT_DIST_SUM
        -if CHECK_POINT is marked as isSegmentSplit (or is the last achieved CHECK_POINT):
          -include CHECK_POINT_GPS_READING as a SEGMENT_CHECK_POINT_GPS_READING
          NOTE: see --all-checkpoints
    -for each SEGMENT_CHECK_POINT_GPS_READING:
      -calculate the <SEGMENT_DISTANCE> since previous SEGMENT_CHECK_POINT_GPS_READING
      -calculate the <SEGMENT_DURATION> since previous SEGMENT_CHECK_POINT_GPS_READING
      -format SEGMENT_FMT as <SEGMENT_DURATION>s:<SEGMENT_DISTANCE>m
    -format summary of course distance/duration/segments
    -format workout with total distance, total duration, and segments

  $EXEC [OPTS] --checkpoint|--check-point|--run|--race COURSE_NAME START_TIME [END_TIME]
    -get all <CHECK_POINT_GPS_READING>s as in:
      $EXEC --course COURSE_NAME <START_TIME> <END_TIME>
    -skip the most-recent <CHECK_POINT_GPS_READING> if it is not fully reached
      -remove the last <CHECK_POINT_GPS_READING> if there are no <GPS_READING>s after it
        (the next <GPS_READING> may be closer to the <CHECK_POINT>)
    -use the oldest CHECK_POINT_GPS_READING as FIRST_CHECK_POINT
    -use the most-recent CHECK_POINT_GPS_READING as CUR_CHECK_POINT
    -use the second-most-recent CHECK_POINT_GPS_READING as PREV_CHECK_POINT
    -calculate SEGMENT_DIST as the distance between prev and cur:
      CUR_CHECK_POINT.DISTANCE
    -calculate SEGMENT_DUR_MILLIS as elapsed millis between prev and cur:
      CUR_CHECK_POINT.GPS_READING_EPOCH_MILLIS - PREV_CHECK_POINT.GPS_READING_EPOCH_MILLIS
    -calculate SEGMENT_SPEED_MPH as
      (SEGMENT_DIST/1000) / (SEGMENT_DUR_MILLIS/1000/60/60) * $MILES_PER_KM
    -calculate TOTAL_DIST as the dist from FIRST_CHECK_POINT to CUR_CHECK_POINT
    -calculate TOTAL_DUR_MILLIS as elapsed millis between FIRST_CHECK_POINT and CUR_CHECK_POINT
    -calculate TOTAL_SPEED_MPH as
      (TOTAL_DIST/1000) / (TOTAL_DUR_MILLIS/1000/60/60) * $MILES_PER_KM
    -calculate TOTAL_DIST_KM as TOTAL_DIST/1000
    -use <CUR_CHECK_POINT.PRIORITY> as <PRIORITY>
    -use <CUR_CHECK_POINT.NAME> as <CHECK_POINT_NAME>
    -print:
      <CHECK_POINT_NAME>,<PRIORITY>,<TOTAL_DIST_KM>,<SEGMENT_SPEED_MPH>mph,<TOTAL_SPEED_MPH>mph

  $EXEC [OPTS] START_TIME [END_TIME]
  $EXEC [OPTS] -g|--get START_TIME [END_TIME]
    -if not given, use 'START_TIME + 36h' for END_TIME
    -parse date range as seconds since epoch:
      -parse START_TIME as a date format string into START_EPOCH_S
      -parse END_TIME as a date format string into END_EPOCH_S
    -list gpsinfo csv <LOG_FILE>s:
      $GPSINFO_BAK_DIR/harbour-gpsinfo-<LOG_EPOCH_MILLIS>*.log*
      $GPSINFO_LOG_DIR/harbour-gpsinfo-<LOG_EPOCH_MILLIS>*.log*
    -get <MATCHING_LOG_FILE>s:
      -for each LOG_FILE:
        -truncate LOG_EPOCH_MILLIS to LOG_EPOCH_S (ignore millis)
        -include the *most recent* LOG_FILE where:
            LOG_EPOCH_S <= START_EPOCH_S
        -include all LOG_FILEs where:
            START_EPOCH_S <= LOG_EPOCH_S <= END_EPOCH_S
    -parse each GPS_READING csv row in each MATCHING_LOG_FILE, decompressing if necessary
       -format of each GPS_READING:
         <GPS_READING_EPOCH_MILLIS>,
         <DATE_FMT>,
         lat=<LAT>,lon=<LON>,
         alt=<ALT>m,
         speed=<SPEED>m/s,
         dirMove=<DIR_MOVE>,
         dirComp=<DIR_COMP>,
         vAcc=<V_ACC>m,
         hAcc=<H_ACC>m,
         sat=<SAT>
    -truncate GPS_READING_EPOCH_MILLIS to GPS_READING_EPOCH_S
    -include only <GPS_READING>s where:
      START_EPOCH_S <= GPS_READING_EPOCH_S <= END_EPOCH_S
    -for each <GPS_READING>:
      -calculate <DIST_M> between this <GPS_READING> and the previous <GPS_READING>
      -for each <CHUNK_SIZE> of CHUNK_SIZE=5, CHUNK_SIZE=30, and CHUNK_SIZE=60:
        -get CHUNK_NAME as 'CHUNK<CHUNK_SIZE>'
        -get the last <CHUNK_SIZE> <GPS_READINGS>
          (e.g.: for CHUNK_SIZE=5, get the last 5 readings, including this one)
        -calculate the <CHUNK_NAME>.<ELAPSED_MILLIS> as:
            <LAST_GPS_READING>.<EPOCH_MILLIS> - <FIRST_GPS_READING>.<EPOCH_MILLIS>
        -calculate the <CHUNK_NAME>.<DIST_M> as the sum of all <GPS_READING>.<DIST_M>
        -calculate the <CHUNK_NAME>.<SPEED_M_PER_S> as:
            <CHUNK_NAME>.<DIST_M> / <CHUNK_NAME>.<ELAPSED_MILLIS>
        -calculate the <CHUNK_NAME>.<SPEED_MPH> as:
            <CHUNK_NAME>.<SPEED_M_PER_S> * 60 * 60 * $MILES_PER_KM / 1000
    -calculate distances between <GPS_READINGS>
    -print each <GPS_READING>, one per line, formatted:
      <DATE_FMT>,<LAT>,<LON>,<DIST_M>m,<CHUNK5>.<SPEED_MPH>mph,<CHUNK60>.<SPEED_MPH>mph,<CHUNK30>.<SPEED_MPH>mph

  OPTS
    --all | --all-checkpoints
      ignore is-segment-split and always split segments at all checkpoints

    -d | --detect | --detect-start
      change START_TIME and END_TIME to match checkpoints of actual gps readings
        e.g.: `$EXEC --course COURSE_NAME YYYY-mm-dd`
      -find the START_CHECK_POINT and a MID_CHECK_POINT for the course
      -find start of first period at mid-checkpoint
        -assume this checkpoint is during the first lap
      -go backward from then to find END_OF_PERIOD at start-checkpoint for first-lap
        -this is the last time in start-checkpoint before starting the first lap
      -go backward from then to find START_OF_PERIOD at start-checkpoint for first-lap
        -this is the first time in start-checkpoint before starting the first lap
        -start of first lap is between START_OF_PERIOD and END_OF_PERIOD
      -calculate distances for readings between START_OF_PERIOD and END_OF_PERIOD
        -also include a few readings before and after
      -find last time standing still between START_OF_PERIOD and END_OF_PERIOD
        -standing still is defined as speed <= 0.1m/s over 3 readings ending with this one
        -if no such stillness found, use the last reading in the start-checkpoint (END_OF_PERIOD)
      -use that last reading as START_TIME
      -calculate END_TIME as START_TIME + 12h
      -find the last reading within the region of the entire course area
      -use that reading as END_TIME

   --max-skip=MAX_SKIPPED_CHECKPOINTS
     -when checking if the next <CHECK_POINT> is achieved,
       allow skipping over up to <MAX_SKIPPED_CHECKPOINTS> other <CHECK_POINT>s
     -each CHECK_POINT is reached at most once, and in order
     -skipped CHECK_POINTS are assumed to also be achieved on the way
     -skipped CHECK_POINTS will not be listed separately, but will be combined
     -combine the <SKIPPED_CHECK_POINT>s into the achieved <CHECK_POINT>
        -add the CHECK_POINT.DISTANCE for the <SKIPPED_CHECK_POINT>s
        -omit the skipped <SKIPPED_CHECK_POINT>s
     (default=0, never skip)
";

my $PRIORITY_LOW = "LOW";
my $PRIORITY_MED = "MED";
my $PRIORITY_HIGH = "HIGH";
my $REGEX_OK_PRIORITY = "^($PRIORITY_LOW|$PRIORITY_MED|$PRIORITY_HIGH)\$";
my %PRIORITY_RANK = ($PRIORITY_LOW => 1, $PRIORITY_MED => 2, $PRIORITY_HIGH => 3);

my $MODE_GET = "get";
my $MODE_KML = "kml";
my $MODE_COURSE_KML = "course-kml";
my $MODE_COURSE = "course";
my $MODE_CHECKPOINT = "checkpoint";

sub main(@){
  my $opts = {
    allCheckpoints        => 0,
    detectCourseStart     => 0,
    maxSkippedCheckPoints => 0,
  };
  my $mode = undef;
  my $startTimeStr = undef;
  my $endTimeStr = undef;
  my $courseName = undef;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^(-g|--get)$/){
      $mode = $MODE_GET;
    }elsif($arg =~ /^(-k|--kml)$/){
      $mode = $MODE_KML;
    }elsif($arg =~ /^(--course-kml)$/){
      $mode = $MODE_COURSE_KML;
    }elsif($arg =~ /^(-c|--course|-w|--workout)$/){
      $mode = $MODE_COURSE;
    }elsif($arg =~ /^(--checkpoint|--check-point|--run|--race)$/){
      $mode = $MODE_CHECKPOINT;
    }elsif($arg =~ /^--max-skipped=(\d+)$/){
      $$opts{maxSkippedCheckPoints} = $1;
    }elsif($arg =~ /^(--all|--all-checkpoints)$/){
      $$opts{allCheckpoints} = 1;
    }elsif($arg =~ /^(-d|--detect)$/){
      $$opts{detectCourseStart} = 1;
    }elsif($arg =~ /^\w+$/ and not defined $courseName){
      $mode = $MODE_COURSE if not defined $mode;
      $courseName = $arg;
    }elsif(not defined $startTimeStr){
      $startTimeStr = $arg;
    }elsif(not defined $endTimeStr){
      $endTimeStr = $arg;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }
  $mode = $MODE_GET if not defined $mode;

  my $startEpoch = undef;
  my $endEpoch = undef;
  my $startEpochMillis = undef;
  my $endEpochMillis = undef;
  if($mode =~ /^($MODE_GET|$MODE_KML|$MODE_COURSE|$MODE_CHECKPOINT)$/){
    die "$USAGE\nERROR: missing START_TIME\n" if not defined $startTimeStr;

    $startEpoch = str2time($startTimeStr);
    die "ERROR: date/time parsing failed for START_TIME\n" if not defined $startEpoch;

    if(defined $endTimeStr){
      $endEpoch = str2time($endTimeStr);
    }else{
      $endEpoch = $startEpoch + 36*60*60;
      $endTimeStr = time2str('%Y-%m-%dT%H:%M:%S', $endEpoch);
    }
    die "ERROR: date/time parsing failed for END_TIME\n" if not defined $endEpoch;

    $startEpochMillis = int($startEpoch*1000.0 + 0.5);
    $endEpochMillis = int($endEpoch*1000.0 + 0.5);
  }

  if($mode eq $MODE_GET){
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);
    ensureCalcGpsReadingsDistSpeed(@gpsReadings);
    for my $gpsReading(@gpsReadings){
      printf "%s,%9.6f,%9.6f,%05.2fm,%05.2fmph,%05.2fmph,%05.2fmph\n",
        $$gpsReading{dtmFmt}, $$gpsReading{lat}, $$gpsReading{lon},
        $$gpsReading{dist},
        $$gpsReading{speedMPHLast5}, $$gpsReading{speedMPHLast30}, $$gpsReading{speedMPHLast60},
      ;
    }
  }elsif($mode eq $MODE_KML){
    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);

    my $documentName = time2str("gpsinfo_%Y_%m_%d_%H_%M_%S", $startEpoch);
    print formatKMLGpsReadings($documentName, @gpsReadings);
  }elsif($mode eq $MODE_COURSE_KML){
    die "$USAGE\nERROR: missing COURSE_NAME\n" if not defined $courseName;
    my $config = parseCourseConfigYaml();
    my $course = $$config{$courseName};
    die "$USAGE\nERROR: unknown COURSE_NAME '$courseName'\n" if not defined $course;
    print formatKMLCourse($course);
  }elsif($mode eq $MODE_COURSE){
    die "$USAGE\nERROR: missing COURSE_NAME\n" if not defined $courseName;
    my $config = parseCourseConfigYaml();
    my $course = $$config{$courseName};
    die "$USAGE\nERROR: unknown COURSE_NAME '$courseName'\n" if not defined $course;

    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);

    if($$opts{detectCourseStart}){
      my $courseStartInfo = detectCourseStartForGpsReadings($course, @gpsReadings);

      if(defined $courseStartInfo){
        $startEpochMillis = $$courseStartInfo{startMillis};
        $startEpoch = int($startEpochMillis / 1000.0 + 0.5);
        $startTimeStr = time2str('%Y-%m-%dT%H:%M:%S', $startEpoch);

        $endEpochMillis = $$courseStartInfo{endMillis};
        $endEpoch = int($endEpochMillis / 1000.0 + 0.5);
        $endTimeStr = time2str('%Y-%m-%dT%H:%M:%S', $endEpoch);

        my $skippedPreStartReadings = 0;
        while(@gpsReadings > 0 and ${$gpsReadings[0]}{epochMillis} < $startEpochMillis){
          shift @gpsReadings;
          $skippedPreStartReadings++;
        }

        my $skippedPostEndReadings = 0;
        while(@gpsReadings > 0 and ${$gpsReadings[-1]}{epochMillis} > $endEpochMillis){
          pop @gpsReadings;
          $skippedPostEndReadings++;
        }

        printf "COURSE INFO DETECTED:\n  %s\n  %s\n  %s\n",
          $courseName,
          $startTimeStr,
          $endTimeStr,
        ;
        printf "\n(skipped %d pre-start and %d post-end readings)\n",
          $skippedPreStartReadings,
          $skippedPostEndReadings,
        ;
      }
    }

    my @checkPointGpsReadings = getCheckPointGpsReadings($opts, $course, @gpsReadings);
    if(@checkPointGpsReadings == 0){
      die "ERROR: no checkpoints reached for course=$courseName between $startTimeStr and $endTimeStr\n";
    }

    my @segments = parseCheckPointSegments($opts, @checkPointGpsReadings);

    my $firstReading = $checkPointGpsReadings[0];
    my $lastReading = $checkPointGpsReadings[-1];

    my $gpsTotalDist = $$lastReading{courseProgressDist};
    my $gpsTotalDurMillis = $$lastReading{gpsReading}{epochMillis} - $$firstReading{gpsReading}{epochMillis};
    my $gpsTotalDurFracS = sprintf "%.2f", $gpsTotalDurMillis / 1000.0;

    my $targetDtmDurMillis = $endEpochMillis - $startEpochMillis;
    my $targetDtmDurFracS = sprintf "%.2f", $targetDtmDurMillis / 1000.0;
    if(not $$opts{detectCourseStart} and $gpsTotalDurFracS ne $targetDtmDurFracS){
      #check gps reading times within 0.01s of indicated start/end params
      print STDERR "\n\n\nWARNING: gps checkpoint duration total does not match START/END\n\n\n";
    }

    printf "GPS TOTAL: %s  %.2fm\n", $gpsTotalDurFracS, $gpsTotalDist;
    printf "TARGET DTM DUR: %s\n", $targetDtmDurFracS;
    printf "TIME: %s - %s\n",
      time2str('%H:%M:%S', int($$firstReading{gpsReading}{epochMillis}/1000.0 + 0.5)),
      time2str('%H:%M:%S', int($$lastReading{gpsReading}{epochMillis}/1000.0 + 0.5)),
    ;
    for my $s(@segments){
      my $mph = ($$s{segmentDist}/1000.0*$MILES_PER_KM)/($$s{segmentDurMillis}/1000.0/60/60);
      printf "segment: %-17s|%4.1fmph|%s|%9s|%9.2f|%s\n",
        $$s{format},
        $mph,
        time2str('%H:%M:%S', ($$s{endEpochMillis}/1000.0)),
        formatDurHMS($$s{progDurMillis}/1000.0),
        $$s{progDist},
        $$s{desc},
      ;
    }

    print "\n";
    printf "%s    %.2fmi\n",
      formatDurHMS($gpsTotalDurMillis/1000.0),
      $MILES_PER_KM*$gpsTotalDist/1000.0;
    print "\n\n";

    my $dtmYMD = time2str("%Y-%m-%d", $startEpoch);
    my $workoutID = $startEpoch;

    my $fmt = "#$dtmYMD\n";
    $fmt .= "#  $courseName\n";
    $fmt .= "##### gpsinfo calculated\n";
    $fmt .= "$workoutID.epoch = $startEpoch.000\n";
    $fmt .= "$workoutID.distance = " . sprintf("%.2f", $gpsTotalDist) . "\n";
    $fmt .= "$workoutID.duration = " . sprintf("%.2f", $gpsTotalDurMillis/1000.0) . "\n";
    $fmt .= "$workoutID.intervals = " . join(",", map {$$_{format}} @segments) . "\n";

    print $fmt;
  }elsif($mode eq $MODE_CHECKPOINT){
    die "$USAGE\nERROR: missing COURSE_NAME\n" if not defined $courseName;
    my $config = parseCourseConfigYaml();
    my $course = $$config{$courseName};
    die "$USAGE\nERROR: unknown COURSE_NAME '$courseName'\n" if not defined $course;

    my @gpsReadings = getGpsReadings($startEpochMillis, $endEpochMillis);

    my @checkPointGpsReadings = getCheckPointGpsReadings($course, @gpsReadings);

    if(@checkPointGpsReadings > 0){
      my $lastCheckPoint = $checkPointGpsReadings[-1];
      my $lastGpsReading = $gpsReadings[-1];
      if($$lastCheckPoint{gpsReading}{epochMillis} == $$lastGpsReading{epochMillis}){
        #skip final checkpoint if still potentially moving towards it (min dist is in the future)
        #   only include checkpoints with a gps reading after the checkpoint
        pop @checkPointGpsReadings;
      }
    }

    if(@checkPointGpsReadings == 0){
      die "ERROR: no checkpoints reached for course=$courseName between $startTimeStr and $endTimeStr\n";
    }

    my $firstCheckPoint = $checkPointGpsReadings[0];
    my $curCheckPoint = $checkPointGpsReadings[-1];
    my $prevCheckPoint = $checkPointGpsReadings[-2];

    my $segmentDist = 0;
    my $segmentDurMillis = 0;
    my $segmentSpeedMPH = 0;
    if(defined $prevCheckPoint){
      $segmentDist = $$curCheckPoint{courseProgressDist} - $$prevCheckPoint{courseProgressDist};
      $segmentDurMillis = $$curCheckPoint{gpsReading}{epochMillis} - $$prevCheckPoint{gpsReading}{epochMillis};
      $segmentSpeedMPH = $segmentDurMillis > 0 ? ($segmentDist/1000.0)/($segmentDurMillis/1000/60/60)*$MILES_PER_KM : 0;
    }

    my $totalDist = $$curCheckPoint{courseProgressDist} - $$firstCheckPoint{courseProgressDist};
    my $totalDurMillis = $$curCheckPoint{gpsReading}{epochMillis} - $$firstCheckPoint{gpsReading}{epochMillis};
    my $totalSpeedMPH = $totalDurMillis > 0 ? ($totalDist/1000.0)/($totalDurMillis/1000/60/60)*$MILES_PER_KM : 0;

    printf "%s,%s,%.1fkm,%.1fmi,%.1fmph,%.1fmph\n",
      $$curCheckPoint{checkPoint}{name},
      $$curCheckPoint{checkPoint}{priority},
      $totalDist/1000.0,
      $totalDist/1000.0*$MILES_PER_KM,
      $segmentSpeedMPH,
      $totalSpeedMPH,
    ;
  }else{
    die "ERROR: unknown mode $mode\n";
  }
}

sub getGpsReadings($$){
  my ($startEpochMillis, $endEpochMillis) = @_;
  my @allGpsLogFiles = grep {-f $_} (
    glob("$GPSINFO_BAK_DIR/*.log*"),
    glob("$GPSINFO_LOG_DIR/*.log*"),
  );

  #sort by filename epoch
  my %logFilesByEpochMillis;
  for my $logFile(@allGpsLogFiles){
    if($logFile =~ /harbour-gpsinfo-(\d+)(?:_\w+)?\.log(?:\.\w+)?$/){
      my $epochMillis = $1;
      $logFilesByEpochMillis{$epochMillis} = $logFile;
    }
  }

  my @okLogFiles;
  my $includedMostRecentOlder = 0;
  for my $logEpochMillis(reverse sort keys %logFilesByEpochMillis){
    my $logFile = $logFilesByEpochMillis{$logEpochMillis};
    #include the last file /older/ than the start,
    #  plus all files after that that end before end
    if($logEpochMillis > $endEpochMillis){
      next;
    }
    push @okLogFiles, $logFile;
    if($logEpochMillis < $startEpochMillis){
      last;
    }
  }

  my $startEpoch = int($startEpochMillis/1000.0);
  my $endEpoch = int($endEpochMillis/1000.0);

  my @readings;
  for my $file(reverse @okLogFiles){
    my @lines;
    if($file =~ /\.gz$/){
      @lines = `zcat '$file'`;
    }elsif($file =~ /\.xz$/){
      @lines = `xzcat '$file'`;
    }elsif($file =~ /\.log$/){
      @lines = `cat '$file'`;
    }

    for my $line(@lines){
      if($line !~ /^(\d+),([^,]*),lat=(-?\d+\.\d+|\?*),lon=(-?\d+\.\d+|\?*),/){
        die "ERROR: malformed line in $file\n$line\n";
      }
      my ($epochMillis, $dtmFmt, $lat, $lon) = ($1, $2, $3, $4);
      next if $lat !~ /^-?\d+\.\d+$/ or $lon !~ /^-?\d+\.\d+$/;

      my $epoch = int($epochMillis/1000.0);
      if($startEpoch <= $epoch && $epoch <= $endEpoch){
        push @readings, {epochMillis=>$epochMillis, dtmFmt=>$dtmFmt, lat=>$lat, lon=>$lon};
      }
    }
  }
  return @readings;
}

sub ensureCalcGpsReadingsDistSpeed(@){
  my @gpsReadings = @_;
  if(@gpsReadings < 0 or defined ${$gpsReadings[0]}{dist}){
    return;
  }
  my $gis = GIS::Distance->new();
  for(my $i=0; $i<@gpsReadings; $i++){
    my $cur = $gpsReadings[$i];
    my $prev = ($i-1) >= 0 ? $gpsReadings[($i-1)] : undef;
    my $dist = 0;
    if(defined $prev){
      $dist = $gis->distance(
        $$prev{lat}, $$prev{lon},
        $$cur{lat}, $$cur{lon},
      )->meters();
    }
    $$cur{dist} = $dist;
  }

  for(my $i=0; $i<@gpsReadings; $i++){
    my $cur = $gpsReadings[$i];
    $$cur{speedMPHLast5} =  ($i-5+1)  >= 0 ? calcSpeedMPH(@gpsReadings[($i-5+1)  .. $i]) : 0;
    $$cur{speedMPHLast10} = ($i-10+1) >= 0 ? calcSpeedMPH(@gpsReadings[($i-10+1) .. $i]) : 0;
    $$cur{speedMPHLast30} = ($i-30+1) >= 0 ? calcSpeedMPH(@gpsReadings[($i-30+1) .. $i]) : 0;
    $$cur{speedMPHLast60} = ($i-60+1) >= 0 ? calcSpeedMPH(@gpsReadings[($i-60+1) .. $i]) : 0;
  }
}

sub calcSpeedMPH(@){
  my @gpsReadings = @_;
  my $speedMPerS = calcSpeedMPerS(@gpsReadings);
  my $speedMPH = ($speedMPerS/1000.0)*60*60 * $MILES_PER_KM;
  return sprintf("%.2f", $speedMPH);
}
sub calcSpeedMPerS(@){
  my @gpsReadings = @_;
  return 0 if @gpsReadings == 0;

  my $first = $gpsReadings[0];
  my $last = $gpsReadings[-1];

  my $distM = sum(map{$$_{dist}} @gpsReadings);
  my $elapsedS = int( ($$last{epochMillis} - $$first{epochMillis})/1000.0 + 0.5);

  my $speedMPerS = $elapsedS == 0 ? 0 : $distM/$elapsedS;
  return $speedMPerS;
}

sub detectCourseStartForGpsReadings($@){
  my ($course, @gpsReadings) = @_;

  ensureCoursePolygonObj($course);

  my $courseName = $$course{courseName};
  my @checkPoints = @{$$course{checkPoints}};
  if(@checkPoints < 2){
    die "ERROR: invalid lap checkpoints for $courseName\n";
  }
  my $startCP = $checkPoints[0];
  my $midCP = $checkPoints[1];

  #1) find start of first period at mid-checkpoint (presumed to be during the first lap)
  my $firstLapMidCPBeginIndex = undef;
  for(my $i=0; $i<@gpsReadings; $i++){
    my $gpsReading = $gpsReadings[$i];
    if(isPointInPolygonObj($gpsReading, $$midCP{polygonObj})){
      $firstLapMidCPBeginIndex = $i;
      last;
    }
  }

  #2) go backward from then to find end of period at start-checkpoint for first-lap
  my $firstLapStartCPEndIndex = undef;
  if(defined $firstLapMidCPBeginIndex){
    #go backwards from start of mid-checkpoint to end of start-checkpoint
    for(my $i=$firstLapMidCPBeginIndex; $i>=0; $i--){
      my $gpsReading = $gpsReadings[$i];
      if(isPointInPolygonObj($gpsReading, $$startCP{polygonObj})){
        $firstLapStartCPEndIndex = $i;
        last;
      }
    }
  }

  #3) go backward from then to find start of period at start-checkpoint for first-lap
  my $firstLapStartCPBeginIndex = undef;
  if(defined $firstLapStartCPEndIndex){
    #go backwards from end of start-checkpoint to beginning of start-checkpoint
    for(my $i=$firstLapStartCPEndIndex; $i>=0; $i--){
      my $gpsReading = $gpsReadings[$i];
      if(isPointInPolygonObj($gpsReading, $$startCP{polygonObj})){
        $firstLapStartCPBeginIndex = $i;
      }else{
        #stop once outside of start-checkpoint
        last;
      }
    }
  }

  #4) calculate distances for readings near the start-checkpoint for first-lap
  if(defined $firstLapStartCPBeginIndex and defined $firstLapStartCPEndIndex){
    my $startIndex = $firstLapStartCPBeginIndex - 5;
    my $endIndex = $firstLapStartCPEndIndex + 5;
    $startIndex = 0 if $startIndex < 0;
    $endIndex = $#gpsReadings if $endIndex > $#gpsReadings;

    my @nearFirstLapStartCPReadings = @gpsReadings[$startIndex .. $endIndex];

    ensureCalcGpsReadingsDistSpeed(@nearFirstLapStartCPReadings);
  }

  #5) find the last region with negligible speed (<0.1 m/s) before leaving start-checkpoint, if any
  my $runStartGpsReading = undef;
  if(defined $firstLapStartCPBeginIndex and defined $firstLapStartCPEndIndex){
    my $speedCutoffMPerS = 0.1;
    for(my $i=$firstLapStartCPEndIndex; $i>=$firstLapStartCPBeginIndex; $i--){
      #any reading in the start-checkpoint is acceptable
      $runStartGpsReading = $gpsReadings[$i];

      my $gpsReading = $gpsReadings[$i];
      my $priorIndex = $i-2;
      $priorIndex = 0 if $priorIndex < 0;

      my @priorReadings = @gpsReadings[$priorIndex .. $i];
      if(@priorReadings >= 3){
        my $speedMPerS = calcSpeedMPerS(@priorReadings);
        if($speedMPerS <= $speedCutoffMPerS){
          #not moving or moving with negligible speed at this time
          last;
        }
      }
    }
  }

  #6) identify the last gps reading in the entire course area within 12h of start
  my $runEndGpsReading = undef;
  if(defined $runStartGpsReading){
    my $cutoffMillis = $$runStartGpsReading{epochMillis} + 12*60*60*1000;
    for(my $i=$#gpsReadings; $i>=0; $i--){
      my $gpsReading = $gpsReadings[$i];
      next if $$gpsReading{epochMillis} > $cutoffMillis;
      if(isPointInPolygonObj($gpsReading, $$course{areaPolygonObj})){
        $runEndGpsReading = $gpsReading;
        last;
      }
    }
  }

  if(defined $runStartGpsReading and defined $runEndGpsReading){
    return {
      courseName  => $courseName,
      startMillis => $$runStartGpsReading{epochMillis},
      endMillis   => $$runEndGpsReading{epochMillis},
    };
  }

  return undef;
}

sub getCheckPointGpsReadings($$@){
  my ($opts, $course, @gpsReadings) = @_;

  my @checkPointGpsReadings;

  if(@gpsReadings == 0){
    return @checkPointGpsReadings;
  }

  my $firstReading = $gpsReadings[0];

  ensureCoursePolygonObj($course);

  my $gis = GIS::Distance->new();

  my %completedTargets;

  my $courseProgressDist = 0;
  my @checkPoints = @{$$course{checkPoints}};

  my $startCPIdx = 0;
  for(my $i=0; $i<@gpsReadings; $i++){
    my $gpsReading = $gpsReadings[$i];

    last if $startCPIdx >= @checkPoints;

    my $checkPoint = undef;
    for(my $endCPIdx=$startCPIdx; $endCPIdx<@checkPoints; $endCPIdx++){
      if($endCPIdx > $startCPIdx + $$opts{maxSkippedCheckPoints}){
        #only permit 'skipping' up to MAX_SKIPPED_CHECKPOINTS checkpoints
        last;
      }
      my $curCheckPoint = $checkPoints[$endCPIdx];

      if(isPointInPolygonObj($gpsReading, $$curCheckPoint{polygonObj})){
        my @cps = @checkPoints[$startCPIdx..$endCPIdx];

        #combine any skipped checkpoints into the achieved checkpoint
        $checkPoint = combineCheckPoints(@checkPoints[$startCPIdx..$endCPIdx]);

        $startCPIdx = $endCPIdx + 1;
        last;
      }
    }

    if(defined $checkPoint){
      #one of the next (MAX_SKIPPED_CHECKPOINTS+1) checkpoints achieved
      #  current gps reading is within the bounding polygon of the checkpoint

      my $dist = $gis->distance(
        $$checkPoint{lat}, $$checkPoint{lon},
        $$gpsReading{lat}, $$gpsReading{lon}
      )->meters();

      my $localMinGpsReading = $gpsReading;
      my $minDist = $dist;
      my $isFirstEntry = $i == 0 ? 1 : 0;

      while(isPointInPolygonObj($gpsReading, $$checkPoint{polygonObj}) && $i+1 < @gpsReadings){
        #skip all adjacent readings within the bounding polygon
        #use the minimum distance point within the polygon
        $i++;
        $gpsReading = $gpsReadings[$i];
        $dist = $gis->distance(
          $$checkPoint{lat}, $$checkPoint{lon},
          $$gpsReading{lat}, $$gpsReading{lon}
        )->meters();

        if($dist<$minDist and not $isFirstEntry){
          #if first checkpoint is at first entry, use first entry instead of closest entry
          $localMinGpsReading = $gpsReading;
          $minDist = $dist;
        }
      }

      $courseProgressDist += $$checkPoint{dist};

      push @checkPointGpsReadings, {
        courseProgressDist=>$courseProgressDist,
        checkPoint=>$checkPoint,
        gpsReading=>$localMinGpsReading,
      };
    }
  }

  return @checkPointGpsReadings;
}

sub combineCheckPoints(@){
  my (@checkPoints) = @_;
  if(@checkPoints == 0){
    return undef;
  }else{
    my $lastCheckPoint = $checkPoints[-1];
    my $dist = 0;
    my $priority = $PRIORITY_LOW;
    my $isSegmentSplit = 0;
    for my $checkPoint(@checkPoints){
      $dist += $$checkPoint{dist};
      if($PRIORITY_RANK{$$checkPoint{priority}} > $PRIORITY_RANK{$priority}){
        $priority = $$checkPoint{priority};
      }
      $isSegmentSplit = 1 if $$checkPoint{isSegmentSplit} == 1;
    }

    return {
      name           => $$lastCheckPoint{name},
      lat            => $$lastCheckPoint{lat},
      lon            => $$lastCheckPoint{lon},
      polygon        => $$lastCheckPoint{polygon},
      polygonObj     => $$lastCheckPoint{polygonObj},
      dist           => $dist,
      priority       => $priority,
      isSegmentSplit => $isSegmentSplit,
    };
  }
}

sub parseCourseConfigYaml(){
  my $config = {};
  my @yamlFiles = grep {-f $_} glob "$CONFIG_DIR/*.yaml";
  my $ypp = YAML::PP->new;
  for my $yamlFile(@yamlFiles){
    my @yamlDocs;
    try{
      @yamlDocs = $ypp->load_file($yamlFile);
    }catch($err){
      die "ERROR: failed to load $yamlFile\n$err\n";
    }

    if(@yamlDocs != 1){
      die "ERROR: $yamlFile is invalid\n";
    }

    my $doc = $yamlDocs[0];
    my $courses = $$doc{COURSES};
    my $locationsLatLon = $$doc{LOCATIONS};
    my $lapTypes = $$doc{LAP_TYPES};
    my $areaPolygonLatLon = $$doc{AREA_POLYGON_LAT_LON};

    die "ERROR: $yamlFile missing COURSES\n" if not isHash($courses);
    die "ERROR: $yamlFile missing LOCATIONS\n" if not isHash($locationsLatLon);
    die "ERROR: $yamlFile missing LAP_TYPES\n" if not isHash($lapTypes);
    die "ERROR: $yamlFile missing AREA_POLYGON_LAT_LON\n" if not isArr($areaPolygonLatLon);

    my @areaPolygon = map {parseLatLon($_)} @$areaPolygonLatLon;
    for my $latLon(@areaPolygon){
      die "ERROR: invalid AREA_POLYGON_LAT_LON for $yamlFile\n" if not defined $latLon;
    }
    if(@areaPolygon > 0){
      #close the polygon
      push @areaPolygon, $areaPolygon[0];
    }

    my $locations = {};
    for my $locName(sort keys %$locationsLatLon){
      my $loc = $$locationsLatLon{$locName};

      my $latLonPoint = parseLatLon($$loc{latLonPoint});
      die "ERROR: invalid 'lat,lon' for $locName\n" if not defined $latLonPoint;

      my $latLonPolygonArr = $$loc{latLonPolygon};
      die "ERROR: invalid polygon for $locName\n" if not isArr($latLonPolygonArr);

      my @latLonPolygon = map {parseLatLon($_)} @$latLonPolygonArr;
      for my $latLon(@latLonPolygon){
        die "ERROR: invalid polygon for $locName\n" if not defined $latLon;
      }

      if(@latLonPolygon > 0){
        #close the polygon
        push @latLonPolygon, $latLonPolygon[0];
      }

      $$locations{$locName} = {
        lat     => $$latLonPoint{lat},
        lon     => $$latLonPoint{lon},
        polygon => [@latLonPolygon],
      }
    }

    for my $courseName(sort keys %$courses){
      my $laps = $$courses{$courseName};
      die "ERROR: $yamlFile $courseName invalid\n" if not isArr($laps);

      $$config{$courseName} = {
        courseName  => $courseName,
        areaPolygon => [@areaPolygon],
        locations   => $locations,
        checkPoints => [],
      };

      for my $lap(@$laps){
        my $lapName = $$lap{lapName};
        die "ERROR: $yamlFile $courseName invalid\n" if not defined $lapName;

        my $lapTypeName = $$lap{lapType};
        my $lapType = $$lapTypes{$lapTypeName};
        die "ERROR: $yamlFile invalid lap type $lapTypeName\n" if not isArr($lapType);

        for my $cpArr(@$lapType){
          die "ERROR: $yamlFile invalid lap type $lapTypeName\n" if not isArr($cpArr);
          die "ERROR: $yamlFile invalid lap type $lapTypeName\n" if @$cpArr != 5;

          my ($checkPointNameTemplate, $dist, $priority, $isSegmentSplit, $locName) = @$cpArr;

          my $checkPointName = $checkPointNameTemplate;
          $checkPointName =~ s/\$\{lapName\}/$lapName/g;

          $isSegmentSplit = $isSegmentSplit ? 1 : 0;

          die "ERROR: invalid check point name '$checkPointName'\n" if $checkPointName !~ /^\w+$/;
          die "ERROR: invalid distance for $lapTypeName\n" if $dist !~ /^(\d+|\d*\.\d+)/;
          die "ERROR: invalid priority for $lapTypeName\n" if $priority !~ $REGEX_OK_PRIORITY;

          my $loc = $$locations{$locName};
          die "ERROR: invalid location '$locName'\n" if not isHash($loc);

          push @{$$config{$courseName}{checkPoints}}, {
            name           => $checkPointName,
            lat            => $$loc{lat},
            lon            => $$loc{lon},
            polygon        => $$loc{polygon},
            dist           => $dist,
            priority       => $priority,
            isSegmentSplit => $isSegmentSplit,
          };
        }
      }
    }
  }

  return $config;
}

sub parseCheckPointSegments($@){
  my ($opts, @checkPointGpsReadings) = @_;
  die "ERROR: empty checkpoint gps readings\n" if @checkPointGpsReadings == 0;
  my $firstReading = $checkPointGpsReadings[0];

  my @segments;
  my $i=0;
  while($i+1 < @checkPointGpsReadings){
    my $segmentStartIdx = $i;
    my $segmentEndIdx = $i+1;

    my $segmentStart = $checkPointGpsReadings[$segmentStartIdx];
    my $segmentEnd = $checkPointGpsReadings[$segmentEndIdx];
    while($segmentEndIdx+1 < @checkPointGpsReadings){
      if($$opts{allCheckpoints} or $$segmentEnd{checkPoint}{isSegmentSplit}){
        last;
      }else{
        $segmentEndIdx++;
        $segmentEnd = $checkPointGpsReadings[$segmentEndIdx];
      }
    }

    my $dist = $$segmentEnd{courseProgressDist} - $$segmentStart{courseProgressDist};
    my $durMillis = $$segmentEnd{gpsReading}{epochMillis} - $$segmentStart{gpsReading}{epochMillis};
    push @segments, {
      segmentDist      => $dist,
      segmentDurMillis => $durMillis,
      startEpochMillis => $$segmentStart{gpsReading}{epochMillis},
      endEpochMillis   => $$segmentEnd{gpsReading}{epochMillis},
      progDist         => $$segmentEnd{courseProgressDist} - $$firstReading{courseProgressDist},
      progDurMillis    => $$segmentEnd{gpsReading}{epochMillis} - $$firstReading{gpsReading}{epochMillis},
      desc             => "$$segmentStart{checkPoint}{name} => $$segmentEnd{checkPoint}{name}",
      format           => sprintf("%.2fs:%.2fm", $durMillis/1000.0, $dist),
    };

    $i = $segmentEndIdx;
  }
  return @segments;
}

sub formatKMLGpsReadings($@){
  my ($documentName, @gpsReadings) = @_;

  my @points = map {
    {name=>$$_{dtmFmt}, id=>$$_{epochMillis}, lat=>$$_{lat}, lon=>$$_{lon}}
  } @gpsReadings;

  return formatKMLPointsPolygons($documentName, [@points], []);
}

sub formatKMLCourse($){
  my ($course) = @_;

  my %locations = %{$$course{locations}};

  my $courseName = $$course{courseName};
  my $documentName = "course-$courseName";
  my @points;
  my @polygons;

  push @polygons, {
    name=>"area_polygon_$courseName",
    id=>"area_polygon_$courseName",
    points=>$$course{areaPolygon},
  };

  for my $name(sort keys %locations){
    push @points, {
      name=>$name, id=>$name, lat=>$locations{$name}{lat}, lon=>$locations{$name}{lon}
    };
    push @polygons, {
      name=>"polygon_$name", id=>"polygon_$name", points=>$locations{$name}{polygon}
    };
  }

  return formatKMLPointsPolygons($documentName, [@points], [@polygons]);
}

sub formatKMLPointsPolygons($$$){
  my ($documentName, $points, $polygons) = @_;

  my $kml = ""
    . "<?xml version=\"1.0\" encoding=\"utf-8\" ?>\n"
    . "<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n"
    . "<Document id=\"root_doc\">\n"
    . "<Schema name=\"$documentName\" id=\"$documentName\">\n"
    . "  <SimpleField name=\"ID\" type=\"string\"></SimpleField>\n"
    . "</Schema>\n"
    . "<Folder>\n"
    . "  <name>$documentName</name>\n"
  ;

  my $index = 1;

  for my $pt(@$points){
    $kml .= ""
      . "  <Placemark id=\"$documentName.$index\">\n"
      . "    <name>$$pt{name}</name>\n"
      . "    <ExtendedData>\n"
      . "      <SchemaData schemaUrl=\"#$documentName\">\n"
      . "        <SimpleData name=\"ID\">$$pt{id}</SimpleData>\n"
      . "      </SchemaData>\n"
      . "    </ExtendedData>\n"
      . "    <Point><coordinates>$$pt{lon},$$pt{lat}</coordinates></Point>\n"
      . "  </Placemark>\n"
    ;
    $index++;
  }
  for my $poly(@$polygons){
    my @coords;
    for my $pt(@{$$poly{points}}){
      push @coords, "$$pt{lon},$$pt{lat}";
    }
    my $coordsFmt = join " ", @coords;
    $kml .= ""
      . "  <Placemark id=\"$documentName.$index\">\n"
      . "    <name>$$poly{name}</name>\n"
      . "    <ExtendedData>\n"
      . "      <SchemaData schemaUrl=\"#$documentName\">\n"
      . "        <SimpleData name=\"ID\">$$poly{id}</SimpleData>\n"
      . "      </SchemaData>\n"
      . "    </ExtendedData>\n"
      . "    <Polygon>\n"
      . "      <outerBoundaryIs><LinearRing><coordinates>\n"
      . "      $coordsFmt\n"
      . "      </coordinates></LinearRing></outerBoundaryIs>\n"
      . "    </Polygon>\n"
      . "  </Placemark>\n"
    ;
    $index++;
  }
  $kml .= ""
    . "</Folder>\n"
    . "</Document>\n"
    . "</kml>\n"
  ;

  return $kml;
}

sub formatDurHMS($){
  my ($t) = @_;
  my $h = int($t / 60.0 / 60.0);
  my $m = int($t / 60.0) % 60;
  my $s = int($t) % 60;
  return sprintf("%dh%02dm%02ds", $h, $m, $s);
}

sub ensureCoursePolygonObj($){
  my ($course) = @_;
  if(not defined $$course{areaPolygonObj}){
    $$course{areaPolygonObj} = getPolygonObj($$course{areaPolygon});
  }
  for my $checkPoint(@{$$course{checkPoints}}){
    if(not defined $$checkPoint{polygonObj}){
      $$checkPoint{polygonObj} = getPolygonObj($$checkPoint{polygon});
    }
  }
}

sub getPolygonObj($){
  my ($polygonPoints) = @_;

  if(@$polygonPoints == 0){
    return undef;
  }

  my @polyXY = map {[$$_{lon}, $$_{lat}]} @$polygonPoints;

  my $polygonObj = Math::Polygon->new(points => [@polyXY]);
  return $polygonObj;
}

sub isPointInPolygonObj($$){
  my ($point, $polygonObj) = @_;

  my $pointXY = [$$point{lon}, $$point{lat}];
  return $polygonObj->contains($pointXY);
}

sub parseLatLon($){
  my ($latLonStr) = @_;
  if(not defined $latLonStr){
    return undef;
  }elsif($latLonStr =~ /^(-?\d+|-?\d+\.\d+),(-?\d+|-?\d+\.\d+)$/){
    return {lat => $1, lon => $2};
  }else{
    return undef;
  }
}

sub isHash($){
  my ($ref) = @_;
  return defined $ref && ref($ref) eq 'HASH' ? 1 : 0;
}
sub isArr($){
  my ($ref) = @_;
  return defined $ref && ref($ref) eq 'ARRAY' ? 1 : 0;
}

&main(@ARGV);
