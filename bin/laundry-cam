#!/bin/sh

IPMAGIC_NAME=raspi-basement

TMP_FILE=/tmp/laundry-cam.jpg
CAM_EDIT_FILE=/tmp/laundry-cam-edit.jpg

ipmagic $IPMAGIC_NAME -s "
  rm -f $TMP_FILE $CAM_EDIT_FILE;

  v4l2-ctl -d /dev/video0 \
    --set-ctrl=auto_exposure=1 \
    --set-ctrl=exposure_time_absolute=100 \
    --set-ctrl=brightness=-50 \
    --set-ctrl=contrast=32 \
    --set-ctrl=sharpness=7 \
    --set-ctrl=gamma=300 \
  ;
  ffmpeg \
    -f v4l2 \
    -video_size 1280x720 \
    -i /dev/video0 \
    -frames 1 \
    -y \
    $TMP_FILE \
  ;
  convert -rotate 180 -crop 500x120+300+50 $TMP_FILE $CAM_EDIT_FILE
"

ipmagic $IPMAGIC_NAME --scp :$CAM_EDIT_FILE $CAM_EDIT_FILE
timeout 5s feh $CAM_EDIT_FILE
