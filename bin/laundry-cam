#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);

sub captureCams($);
sub fetchImgIpmagic($$);
sub fetchImgSeedbox($);
sub isImgRecent();
sub viewImg($);
sub handleCam($);
sub ffmpegSnapshot($$$);
sub appendCameraImages();
sub lookupVideoDevByVidPid($);
sub uploadToSeedbox();
sub downloadFromSeedbox();
sub isLocalIpmagicName($);
sub mtime($);

my $EXEC = basename $0;

my $DEFAULT_IPMAGIC_NAME = "raspi-basement";

my $IMG_DEST = "/tmp/laundry-cam.jpg";
my $TMP_IMG_PREFIX = "/tmp/laundry-cam-tmp";
my $SEEDBOX_IMG_FILE = "laundry.jpg";

my $MAGICK_ARG_APPEND_HORIZONTAL = "+append";
my $MAGICK_ARG_APPEND_VERTICAL = "-append";

my $MAGICK_ARG_APPEND = $MAGICK_ARG_APPEND_VERTICAL;

my @CAM_ORDER = qw(washer dryer);

my $CAMS = {
  washer => {
    camVidPid  => "05a3:9320",
    v4lCamRes  => "1280x720",
    magickArgs => [qw(-rotate 180 -crop 500x120+300+50 -resize 1500x360)],
    v4lCfgArgs => [qw(
                     --set-ctrl=auto_exposure=1
                     --set-ctrl=exposure_time_absolute=100
                     --set-ctrl=brightness=-50
                     --set-ctrl=contrast=32
                     --set-ctrl=sharpness=7
                     --set-ctrl=gamma=300
    )],
  },

  dryer => {
    camVidPid  => "32e4:0298",
    v4lCamRes  => "2320x1744",
                     #2320x1744,4656x3496,3840x2160,3264x2448,2592x1944,2048x1536,
                     #1920x1080,1600x1200,1280x960,1280x720,1024x768,800x600,2320x1744
    magickArgs => [qw(-rotate -90 -crop 1500x550+0+650)],
    v4lCfgArgs => [qw(
                     --set-ctrl=auto_exposure=1
                     --set-ctrl=exposure_time_absolute=100
                     --set-ctrl=brightness=-50
                     --set-ctrl=contrast=32
                     --set-ctrl=sharpness=7
                     --set-ctrl=gamma=300
    )],
  },
};

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC [OPTS]
  $EXEC [OPTS] --ipmagic-capture-or-fetch
    -get LOCAL_IPMAGIC_NAME
    -if LOCAL_IPMAGIC_NAME is '$DEFAULT_IPMAGIC_NAME':
      -capture the images locally
        -as in: $EXEC --capture
    -otherwise:
      -check if $DEFAULT_IPMAGIC_NAME is on local network
        -as in: ipmagic $DEFAULT_IPMAGIC_NAME -r 0 --ip
      -if on local network, fetch the images remotely
        -as in: $EXEC --fetch=$DEFAULT_IPMAGIC_NAME
      -otherwise, fetch the images over seedbox:
        -as in: $EXEC --fetch-seedbox

  $EXEC [OPTS] --capture
    use video4linux2 to grab a frame from laundry webcams
      -for each cam in: @CAM_ORDER
        -detect hardware camera device
        -use `ffmpeg -f v4l2` to capture one frame
        -rotate, crop, and resize frame with imagemagick `convert`
      -append each frame into a single image to:
        $IMG_DEST
      -if --upload-seedbox is given, upload $IMG_DEST to seedbox
        -as in: rsync -avP $IMG_DEST `seedbox`:$SEEDBOX_IMG_FILE

  $EXEC [OPTS] -f IPMAGIC_NAME
  $EXEC [OPTS] --fetch=IPMAGIC_NAME
    -remove local $IMG_DEST
    -copy $IMG_DEST from IPMAGIC_NAME to local
    -if $IMG_DEST mtime is older than 120s (or --always-capture is given):
      -capture images remotely (uploading to seedbox if --upload seedbox given)
        -as in: ipmagic IPMAGIC_NAME $EXEC --capture [--upload-seedbox]
      -re-copy $IMG_DEST from IPMAGIC_NAME to local
      -if $IMG_DEST mtime is still older than 120s:
        -FAIL: exit with an error message
    -view the image (unless --no-view given):
      -run: feh $IMG_DEST

  $EXEC [OPTS] --fetch-seedbox
    -download $IMG_DEST from seedbox
      -as in: rsync -avP `seedbox --host`:$SEEDBOX_IMG_FILE $IMG_DEST
    -if $IMG_DEST mtime is older than 120s (or --always-capture is given):
      -capture new images over seedbox tunnel, on default IPMAGIC_NAME
        -as in: seedbox -r $EXEC --ipmagic-capture-or-fetch \\
                                 --always-capture --no-view --upload-seedbox
      -re-download $IMG_DEST from seedbox
        -as in: rsync -avP `seedbox --host`:$SEEDBOX_IMG_FILE $IMG_DEST
      -if $IMG_DEST mtime is still older than 120s:
        -FAIL: exit with an error message
    -view the image (unless --no-view given):
      -run: feh $IMG_DEST

  OPTS
    -a | --always-capture | --force-remote-capture
      -in --fetch or --ipmagic-capture-or-fetch:
        always run '$EXEC --capture' remotely
        (do not skip based on mtime)

    --upload-seedbox
      after --capture, upload $IMG_DEST to seedbox
        -as in: rsync -avP $IMG_DEST `seedbox --host`:$SEEDBOX_IMG_FILE

    --view
      view the image after fetching
      (this is the default)
    --no-view
      do not view the image after fetching
";

my $MODE_IPMAGIC_CAPTURE_OR_FETCH = "ipmagic-capture-or-fetch";
my $MODE_CAPTURE = "capture";
my $MODE_FETCH = "fetch";
my $MODE_FETCH_SEEDBOX = "fetch-seedbox";

sub main(@){
  my $mode = $MODE_IPMAGIC_CAPTURE_OR_FETCH;
  my $remoteIpmagicName = undef;
  my $opts = {
    alwaysCapture => 0,
    viewImg       => 1,
    uploadSeedbox => 0,
  };
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^(--ipmagic-capture-or-fetch)$/){
      $mode = $MODE_IPMAGIC_CAPTURE_OR_FETCH;
    }elsif($arg =~ /^(--capture)$/){
      $mode = $MODE_CAPTURE;
    }elsif($arg =~ /^(-f)$/ and @_ > 0){
      $mode = $MODE_FETCH;
      $remoteIpmagicName = shift @_;
    }elsif($arg =~ /^--fetch=(.+)$/){
      $mode = $MODE_FETCH;
      $remoteIpmagicName = $1;
    }elsif($arg =~ /^--fetch-seedbox$/){
      $mode = $MODE_FETCH_SEEDBOX;
    }elsif($arg =~ /^(-a|--always-capture|--force-remote-capture)$/){
      $$opts{alwaysCapture} = 1;
    }elsif($arg =~ /^(--upload-seedbox)$/){
      $$opts{uploadSeedbox} = 1;
    }elsif($arg =~ /^(--view)$/){
      $$opts{viewImg} = 1;
    }elsif($arg =~ /^(--no-view)$/){
      $$opts{viewImg} = 0;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  if($mode eq $MODE_CAPTURE){
    die "ERROR: cannot set IPMAGIC_NAME for mode $mode\n" if defined $remoteIpmagicName;
    captureCams($opts);
  }elsif($mode eq $MODE_FETCH){
    die "ERROR: missing IPMAGIC_NAME for mode $mode\n" if not defined $remoteIpmagicName;
    fetchImgIpmagic($opts, $remoteIpmagicName);
    viewImg($opts) if $$opts{viewImg};
  }elsif($mode eq $MODE_IPMAGIC_CAPTURE_OR_FETCH){
    die "ERROR: cannot set IPMAGIC_NAME for mode $mode\n" if defined $remoteIpmagicName;
    if(isLocalIpmagicName($DEFAULT_IPMAGIC_NAME)){
      print "running capture locally\n";
      captureCams($opts);
    }else{
      my $ipAddr = `ipmagic $DEFAULT_IPMAGIC_NAME -r 0 --ip`;
      if($ipAddr =~ /^(\d+)\.(\d+)\.(\d+)\.(\d+)$/){
        print "running fetch over ipmagic $DEFAULT_IPMAGIC_NAME\n";
        fetchImgIpmagic($opts, $DEFAULT_IPMAGIC_NAME);
      }else{
        print "running fetch over seedbox\n";
        fetchImgSeedbox($opts);
      }
      viewImg($opts) if $$opts{viewImg};
    }
  }elsif($mode eq $MODE_FETCH_SEEDBOX){
    die "ERROR: cannot set IPMAGIC_NAME for mode $mode\n" if defined $remoteIpmagicName;
    fetchImgSeedbox($opts);
    viewImg($opts) if $$opts{viewImg};
  }else{
    die "ERROR: unknown mode $mode\n";
  }
}

sub captureCams($){
  my ($opts) = @_;
  system "rm -f $TMP_IMG_PREFIX-*.jpg";

  my @pids;
  for my $camName(@CAM_ORDER){
    my $pid = fork();
    if($pid == 0){
      handleCam($camName);
      exit 0;
    }
    push @pids, $pid;
  }
  for my $pid(@pids){
    waitpid $pid, 0;
  }

  system "rm", "-f", $IMG_DEST;

  die "ERROR: $IMG_DEST already exists\n" if -e $IMG_DEST;
  appendCameraImages();
  die "ERROR: append command failed\n" if not -f $IMG_DEST;

  if($$opts{uploadSeedbox}){
    uploadToSeedbox();
  }

  system "rm -f $TMP_IMG_PREFIX-*.jpg";
}

sub fetchImgIpmagic($$){
  my ($opts, $ipmagicName) = @_;
  system "rm", "-f", $IMG_DEST;

  my $remoteCapture = 0;
  if($$opts{alwaysCapture}){
    $remoteCapture = 1;
  }else{
    print "fetching image and checking if recent\n";
    system "ipmagic", $ipmagicName, "--rsync", "-avP", ":$IMG_DEST", "$IMG_DEST";
    if(not isImgRecent()){
      $remoteCapture = 1;
    }
  }

  if($remoteCapture){
    my @captureCmd = ("ipmagic", $ipmagicName, $EXEC, "--capture");
    push @captureCmd, "--upload-seedbox" if $$opts{uploadSeedbox};

    print "running `@captureCmd`\n";
    system "ipmagic", $ipmagicName, @captureCmd;
    system "ipmagic", $ipmagicName, "--rsync", "-avP", ":$IMG_DEST", "$IMG_DEST";
  }

  if(not isImgRecent()){
    die "ERROR: $IMG_DEST does not exist or is out of date\n";
  }
}

sub fetchImgSeedbox($){
  my ($opts) = @_;
  print "downloading img from seedbox\n";
  downloadFromSeedbox();
  if(not isImgRecent()){
    print "capturing img over seedbox\n";
    system "seedbox", "-r",
      "$EXEC --ipmagic-capture-or-fetch --always-capture --no-view --upload-seedbox";
    print "re-downloading img from seedbox\n";
    downloadFromSeedbox();
  }
  if(not isImgRecent()){
    die "ERROR: $IMG_DEST does not exist or is out of date\n";
  }
}

sub isImgRecent(){
  my $mtime = undef;
  if(-f $IMG_DEST){
    $mtime = mtime($IMG_DEST);
  }

  if(defined $mtime and (time - $mtime < 120)){
    return 1;
  }else{
    return 0;
  }
}

sub viewImg($){
  my ($opts) = @_;
  if(not isImgRecent()){
    die "ERROR: $IMG_DEST does not exist or is out of date\n";
  }

  system "feh", $IMG_DEST;
}

sub handleCam($){
  my ($camName) = @_;

  my $cam = $$CAMS{$camName};
  my $imgCaptureFile = "$TMP_IMG_PREFIX-$camName-capture.jpg";
  my $imgConvertFile = "$TMP_IMG_PREFIX-$camName-convert.jpg";

  my $camDev = lookupVideoDevByVidPid($$cam{camVidPid});
  die "ERROR: missing $camName cam vid:pid $$cam{camVidPid}\n" if not defined $camDev;

  my @v4lCfgArgs = @{$$cam{v4lCfgArgs}};
  system "v4l2-ctl", "-d", $camDev, @v4lCfgArgs;

  my $v4lCamRes = $$cam{v4lCamRes};
  ffmpegSnapshot($camDev, $v4lCamRes, $imgCaptureFile);

  my @magickArgs = @{$$cam{magickArgs}};
  system "convert", $imgCaptureFile, @magickArgs, $imgConvertFile;
}

sub ffmpegSnapshot($$$){
  my ($v4lDev, $res, $outputFile) = @_;
  my @cmd = ("ffmpeg",
    "-f", "v4l2",
    "-video_size", $res,
    "-i", $v4lDev,
    "-frames", 1,
    "-update", "true",
    "-y",
    $outputFile,
  );
  die "ERROR: file $outputFile already exists\n" if -e $outputFile;
  system @cmd;
  die "ERROR: file $outputFile does not exist after @cmd\n" if not -f $outputFile;
}

sub appendCameraImages(){
  my @convertAppendCmd = "convert";
  for my $camName(@CAM_ORDER){
    my $imgConvertFile = "$TMP_IMG_PREFIX-$camName-convert.jpg";
    if(-f $imgConvertFile){
      push @convertAppendCmd, $imgConvertFile;
    }else{
      die "ERROR: cam $camName failed\n";
    }
  }
  push @convertAppendCmd, $MAGICK_ARG_APPEND;
  push @convertAppendCmd, $IMG_DEST;
  system @convertAppendCmd;
}

sub lookupVideoDevByVidPid($){
  my ($vidPid) = @_;
  my ($vid, $pid);
  if($vidPid =~ /^([0-9a-f]{4}):([0-9a-f]{4})$/){
    ($vid, $pid) = ($1, $2);
  }else{
    return undef;
  }

  my @v4lDevDirs = grep {-e $_} glob "/sys/class/video4linux/video*";

  my @okDevNums;
  for my $dir(@v4lDevDirs){
    my $devNum;
    if($dir !~ /^(?:.*\/)?video(\d+)(?:\/.*)?$/){
      die "ERROR: malformed v4l device path $dir\n";
    }
    $devNum = $1;

    my $devVid = `cat $dir/device/../idVendor 2>/dev/null`;
    chomp $devVid;
    my $devPid = `cat $dir/device/../idProduct 2>/dev/null`;
    chomp $devPid;

    if($devVid eq $vid && $devPid eq $pid){
      push @okDevNums, $devNum;
    }
  }

  if(@okDevNums == 0){
    return undef;
  }
  my $dev = "/dev/video$okDevNums[0]";
  if(not -e $dev){
    die "ERROR: missing v4l device $dev\n";
  }

  return $dev;
}

sub uploadToSeedbox(){
  my $sbHost = `seedbox --host`;
  chomp $sbHost;
  system "rsync", "-avP", $IMG_DEST, "$sbHost:$SEEDBOX_IMG_FILE";
}
sub downloadFromSeedbox(){
  my $sbHost = `seedbox --host`;
  chomp $sbHost;
  system "rsync", "-avP", "$sbHost:$SEEDBOX_IMG_FILE", $IMG_DEST;
}

sub isLocalIpmagicName($){
  my ($targetIpmagicName) = @_;
  my @localIpmagicAliases = `ipmagic --get-ipmagic-name-aliases`;
  chomp foreach @localIpmagicAliases;
  my %okIpmagicNames = map {$_ => 1} @localIpmagicAliases;
  return defined $okIpmagicNames{$targetIpmagicName} ? 1 : 0;
}

sub mtime($){
  return (stat $_[0])[9];
}

&main(@ARGV);
