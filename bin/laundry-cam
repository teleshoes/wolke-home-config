#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);

my $EXEC = basename $0;

my $TMP_FILE = "/tmp/laundry-cam.jpg";
my $CAM_EDIT_FILE = "/tmp/laundry-cam-edit.jpg";

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC
    -capture a frame with v4l2
";

sub main(@){
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  system "rm -f $TMP_FILE $CAM_EDIT_FILE";

  system "v4l2-ctl", "-d", "/dev/video0",
    "--set-ctrl=auto_exposure=1",
    "--set-ctrl=exposure_time_absolute=100",
    "--set-ctrl=brightness=-50",
    "--set-ctrl=contrast=32",
    "--set-ctrl=sharpness=7",
    "--set-ctrl=gamma=300",
  ;

  system "ffmpeg",
    "-f", "v4l2",
    "-video_size", "1280x720",
    "-i", "/dev/video0",
    "-frames", "1",
    "-y",
    "$TMP_FILE",
  ;
  system "convert", "-rotate", "180", "-crop", "500x120+300+50", $TMP_FILE, $CAM_EDIT_FILE;
}

&main(@ARGV);
