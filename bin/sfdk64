#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);

sub run(@);

my $EXEC = basename $0;

my $DIR_SAILFISHOS_BASE = "$ENV{HOME}/SailfishOS";
my $EXEC_SFDK = "$DIR_SAILFISHOS_BASE/bin/sfdk";

my $ARCH = "aarch64";

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message
";

sub main(@){
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  my $targets = `$EXEC_SFDK tools target list`;
  my @aarch64Versions = $targets =~ /SailfishOS-([0-9\.]+)-$ARCH/g;

  if(@aarch64Versions == 0){
    die "ERROR: `$EXEC_SFDK tools target list` returned no $ARCH versions\n";
  }

  my $version = $aarch64Versions[0];
  my $target = "SailfishOS-$version-$ARCH";
  run $EXEC_SFDK, "config", "--push", "target", $target;
}

sub run(@){
  print "@_\n";
  system @_;
}

&main(@ARGV);
