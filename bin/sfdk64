#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);

my $EXEC = basename $0;

my $DIR_SAILFISHOS_BASE = "$ENV{HOME}/SailfishOS";
my $EXEC_SFDK = "$DIR_SAILFISHOS_BASE/bin/sfdk";

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message
";

sub main(@){
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  system $EXEC_SFDK, "config", "--push", "target", "SailfishOS-5.0.0.62-aarch64";
}

&main(@ARGV);
