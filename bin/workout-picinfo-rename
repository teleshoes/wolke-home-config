#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);
use List::Util qw(max);

sub handlePicInfoFile($);
sub mtime($);

my $WORKOUT_DCIM_BASE_DIR = "$ENV{HOME}/DCIM/xhealth";
my $KILOMETERS_PER_MILE = 1.609344;

my $EXEC = basename $0;

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC PIC_INFO_FILE [PIC_INFO_FILE PIC_INFO_FILE..]
    print a shell script to rename files in
      $WORKOUT_DCIM_BASE_DIR
    based on the info in each PIC_INFO_FILE
";

sub main(@){
  my @picInfoFiles;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif(-f $arg){
      push @picInfoFiles, $arg;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  die "$USAGE\nERROR: missing PIC_INFO_FILE\n" if @picInfoFiles == 0;

  my @results;
  for my $picInfoFile(@picInfoFiles){
    push @results, handlePicInfoFile($picInfoFile);
  }

  my $error = 0;
  my @changedEntries;
  for my $result(@results){
    for my $file(sort keys %{$$result{fileEntries}}){
      my $entry = $$result{fileEntries}{$file};
      if(not $$entry{success} or defined $$entry{errorMsg}){
        print "# ERROR: parsing info for $file in $$result{picInfoFile} failed\n"
          . "#  $$entry{errorMsg}\n";
        $error = 1;
        next;
      }
      if($$entry{file} ne $$entry{newFile}){
        push @changedEntries, $entry;
      }
    }
  }

  if($error){
    die "\nERROR: picinfo parsing failed\n";
  }

  for my $entry(@changedEntries){
    print "#$$entry{file}\n";
    print "#$$entry{newFile}\n";
    print "# $$entry{infoStr}\n";
    print "mv -n $$entry{file} $$entry{newFile}\n";
    print "\n";
  }
}

sub handlePicInfoFile($){
  my ($picInfoFile) = @_;

  my $result = {
    picInfoFile => $picInfoFile,
    fileEntries => {},
  };

  for my $line(`cat $picInfoFile`){
    next if $line =~ /^\s*(#.*)?$/;
    my ($dirBaseName, $fileBaseName, $ext, $infoStr);
    if($line =~ /^([^\/]*)\/([a-zA-Z0-9_\-]+)\.(jpg|png)\s*:\s*(.+)$/){
      ($dirBaseName, $fileBaseName, $ext, $infoStr) = ($1, $2, $3, $4);
    }elsif($line =~ /^([a-zA-Z0-9_\-]+)\.(jpg|png)\s*:\s*(.+)$/){
      ($dirBaseName, $fileBaseName, $ext, $infoStr) = ("", $1, $2, $3);
    }else{
      die "ERROR: malformed line $line";
    }
    next if $infoStr =~ /^\s*trash\s*$/;

    my $dirPtrn = "";
    if($dirBaseName eq ""){
      $dirPtrn = "*";
    }elsif($dirBaseName =~ /^(?:\.\/)?(\d\d\d\d-\d\d-\d\d)(?:_\w+)?$/){
      $dirPtrn = "$1*";
    }else{
      die "ERROR: invalid dirname $dirBaseName\n";
    }
    if($fileBaseName =~ /^(?:IMG_)?(\d\d\d\d\d\d\d\d_\d\d\d\d\d\d)(?:_[a-zA-Z0-9_\-]+)?$/){
      $fileBaseName = $1;
    }else{
      die "ERROR: invalid filename $fileBaseName\n";
    }

    my $ptrn = "$WORKOUT_DCIM_BASE_DIR/$dirPtrn/*$fileBaseName*.$ext";
    my @files = glob $ptrn;
    if(@files != 1){
      my $msg = @files == 0 ? "could not find" : "too many files match";
      die "ERROR: $msg $ptrn\n";
    }
    my $file = $files[0];

    my ($dirName, $fileName);
    if(-f $file and $file =~ /^(.+)\/([^\/]+)$/){
      ($dirName, $fileName) = ($1, $2);
    }else{
      die "ERROR: invalid file $file\n";
    }

    my @infoValsArr = grep {$_ ne ""} split /\s+/, $infoStr;

    my $infoVals = {};

    my $entry = {
      file            => $file,
      mtime           => mtime "$file",
      dirName         => $dirName,
      fileBaseName    => $fileBaseName,
      fileExt         => $ext,
      infoStr         => $infoStr,
      infoVals        => $infoVals,
      success         => 0,
      errorMsg        => undef,
      fileNameInfoFmt => undef,
      newFile         => undef,
    };

    $$result{fileEntries}{$file} = $entry;

    my @kmDistances;
    for my $val(@infoValsArr){
      if($val =~ /^(\d+):(\d+)$/){
        $$infoVals{time} = $1*60 + $2;
      }elsif($val =~ /^(\d+):(\d+):(\d+)$/){
        $$infoVals{time} = $1*60*60 + $2*60 + $3;
      }elsif($val =~ /^(\d+)s$/){
        $$infoVals{time} = $1;
      }elsif($val =~ /^(\d+)min$/){
        $$infoVals{min} = $1;
      }elsif($val =~ /^offset(\d+):(\d+)$/){
        $$infoVals{offset} = 300 - ($1*60 + $2);
        $$infoVals{isEnd} = 1;
      }elsif($val =~ /^(\d+):(\d+)offset$/){
        $$infoVals{offset} = 300 - ($1*60 + $2);
        $$infoVals{isEnd} = 1;
      }elsif($val =~ /^(\d+):(\d+)offset300$/){
        $$infoVals{offset} = 300 - ($1*60 + $2);
        $$infoVals{isEnd} = 1;
      }elsif($val =~ /^(\d+):(\d+)offset60$/){
        $$infoVals{offset} = 60 - ($1*60 + $2);
        $$infoVals{isEnd} = 1;
      }elsif($val =~ /^remaining(\d+):(\d+)$/){
        $$infoVals{remainingFromTotal} = ($1*60 + $2);
      }elsif($val =~ /^(end)$/){
        $$infoVals{isEnd} = 1;
      }elsif($val =~ /^(run|bike)$/){
        $$infoVals{type} = $val;
      }elsif($val =~ /^(\d+|\d*\.\d+)mi$/){
        push @kmDistances, $1*$KILOMETERS_PER_MILE;
      }elsif($val =~ /^(\d+|\d*\.\d+)cmi$/){
        push @kmDistances, $1*$KILOMETERS_PER_MILE/100.0;
      }elsif($val =~ /^(\d+|\d*\.\d+)km$/){
        push @kmDistances, $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)mph$/){
        $$infoVals{mph} = $1;
      }elsif($val =~ /^(\d\d):(\d\d)pace$/){
        $$infoVals{mph} = sprintf("%.1f", 3600/($1*60+$2));
      }elsif($val =~ /^(\d+|\d*\.\d+)(?:mphavg|avgmph)$/){
        $$infoVals{mphavg} = $1;
      }elsif($val =~ /^(\d\d):(\d\d)(?:avgpace|paceavg)$/){
        $$infoVals{mphavg} = sprintf("%.1f", 3600/($1*60+$2));
      }elsif($val =~ /^(\d+|\d*\.\d+)rpm$/){
        $$infoVals{rpm} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)rpmavg$/){
        $$infoVals{rpmavg} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)cal(?:s?)$/){
        $$infoVals{cal} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)cal\/hr$/){
        $$infoVals{calperhr} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)watts$/){
        $$infoVals{watts} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)mets$/){
        $$infoVals{mets} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)hr$/){
        $$infoVals{hr} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)bpm$/){
        $$infoVals{hr} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)(hrmax|maxhr|peakhr|hrpeak)$/){
        $$infoVals{hrmax} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)v$/){
        $$infoVals{level} = $1;
      }elsif($val =~ /^(\d+|\d*\.\d+)(?:lbs|weight)$/){
        $$infoVals{weight} = $1;
      }elsif($val =~ /^(?:weight|lbs)(\d+|\d*\.\d+)$/){
        $$infoVals{weight} = $1;
      }elsif($val =~ /^(reminder_[a-zA-Z0-9_\-\.]+)$/){
        $$infoVals{reminder} = $1;
      }else{
        $$entry{errorMsg} = "malformed val '$val'\n$line\n";
        last;
      }
    }
    next if defined $$entry{errorMsg};

    #take the max distance and ensure all distances are within 20m of the max
    $$infoVals{km} = max(@kmDistances);

    for my $kmDist(@kmDistances){
      my $diff = $$infoVals{km} - $kmDist;
      $diff = 0-$diff if $diff<0;

      if($diff > 0.02){
        $$entry{errorMsg} = "mismatched distance $kmDist vs $$infoVals{km}\n";
        last;
      }
    }
    next if defined $$entry{errorMsg};

    if(defined $$infoVals{remainingFromTotal}){
      if($$infoVals{time} >= $$infoVals{remainingFromTotal}){
        $$entry{errorMsg} =
          "remaining time $$infoVals{time} exceeds total $$infoVals{remainingFromTotal}\n";
        next;
      }
      $$infoVals{time} = $$infoVals{remainingFromTotal} - $$infoVals{time};
    }

    if(defined $$infoVals{km} and defined $$infoVals{time} and $$infoVals{time} > 0){
      $$infoVals{realMPH} = $$infoVals{km}/$KILOMETERS_PER_MILE/$$infoVals{time}*60*60;
    }
    if(defined $$infoVals{calperhr} and not defined $$infoVals{cal}
       and defined $$infoVals{time} and $$infoVals{time} > 0
    ){
      $$infoVals{cal} = int($$infoVals{calperhr}*$$infoVals{time}/3600 + 0.5);
    }

    if(defined $$infoVals{rpm} or defined $$infoVals{level} or defined $$infoVals{rpmavg}){
      $$infoVals{type} = "bike";
    }
    if(defined $$infoVals{mph}){
      $$infoVals{type} = "run";
    }
    if(not defined $$infoVals{type} and defined $$infoVals{realMPH} and $$infoVals{realMPH} > 12){
      $$infoVals{type} = "bike";
    }
    if(not defined $$infoVals{type}
        and defined $$infoVals{km} and $$infoVals{km} < 20
        and defined $$infoVals{realMPH} and $$infoVals{realMPH} < 10
    ){
      $$infoVals{type} = "run";
    }
    if(defined $$infoVals{reminder}){
      $$infoVals{type} = "reminder";
    }
    if(defined $$infoVals{weight}){
      $$infoVals{type} = "weight";
    }
    if(not defined $$infoVals{type} and $infoStr =~ /^\d+hr$/){
      $$infoVals{type} = "run";
    }
  }

  for my $file(sort keys %{$$result{fileEntries}}){
    my $entry = $$result{fileEntries}{$file};
    my $infoVals = $$entry{infoVals};
    my $closestDiff;
    my $closestEntry;
    my $mtime = $$entry{mtime};
    for my $otherFile(sort keys %{$$result{fileEntries}}){
      next if $file eq $otherFile;
      my $otherEntry = $$result{fileEntries}{$otherFile};
      my $otherMtime = $$otherEntry{mtime};
      my $diff = $mtime - $otherMtime;
      $diff = 0 - $diff if $diff < 0;
      if(not defined $closestDiff or $closestDiff > $diff){
        $closestDiff = $diff;
        $closestEntry = $otherEntry;
      }
    }

    if(not defined $$infoVals{type}){
      print "# WARNING: forcing 'run' for $$entry{file} = $$entry{infoStr}\n";
      $$infoVals{type} = "run";
    }

    my $timeFmt = undef;
    if(defined $$infoVals{time}){
      my $min = int($$infoVals{time} / 60);
      my $sec = int($$infoVals{time}) % 60;
      $timeFmt = sprintf "%02dm%02ds", $min, $sec;
    }

    my $infoFmt;
    if($$infoVals{type} eq "reminder"){
      $infoFmt = $$infoVals{reminder};
    }elsif($$infoVals{type} eq "weight"){
      $infoFmt = "weight-" . sprintf("%05.1flbs", $$infoVals{weight});
    }elsif($$infoVals{type} eq "bike"){
      $infoFmt = "bike";
      $infoFmt .= defined $timeFmt ? "-$timeFmt" : "-__m__s";
      $infoFmt .= defined $$infoVals{level} ? "-$$infoVals{level}v" : "-14v";
      $infoFmt .= defined $$infoVals{km} ? sprintf "-%05.2fkm", $$infoVals{km} : "-_____km";
      if(defined $$infoVals{rpm}){
        $infoFmt .= sprintf "-%03drpm", $$infoVals{rpm};
      }elsif(defined $$infoVals{rpmavg}){
        $infoFmt .= sprintf "-%03drpmavg", $$infoVals{rpmavg};
      }else{
        $infoFmt .= "-___rpm";
      }
      $infoFmt .= defined $$infoVals{cal} ? sprintf("-%03dcal", $$infoVals{cal}) : "-___cal";
      $infoFmt .= defined $$infoVals{hr} ? sprintf("-%03dhr", $$infoVals{hr}) : "-___hr";
    }elsif($$infoVals{type} eq "run"){
      $infoFmt = "run";
      if(defined $$infoVals{min} and defined $$infoVals{mph} and not defined $$infoVals{time}){
        $infoFmt .= sprintf "-%dmin", $$infoVals{min};
        $infoFmt .= sprintf "-%dmph", $$infoVals{mph};
      }else{
        $infoFmt .= defined $timeFmt ? "-$timeFmt" : "-__m__s";
        $infoFmt .= defined $$infoVals{km} ? sprintf "-%05.2fkm", $$infoVals{km} : "-_____km";
        $infoFmt .= defined $$infoVals{mph} ? sprintf("-%04.1fmph", $$infoVals{mph}) : "-____mph";
        $infoFmt .= defined $$infoVals{mphavg} ? sprintf("-%04.1fmphavg", $$infoVals{mphavg}) : "";
        $infoFmt .= defined $$infoVals{cal} ? sprintf("-%03dcal", $$infoVals{cal}) : "";
        $infoFmt .= defined $$infoVals{watts} ? sprintf("-%03dW", $$infoVals{watts}) : "";
        $infoFmt .= defined $$infoVals{mets} ? sprintf("-%04.1fmets", $$infoVals{mets}) : "";
        $infoFmt .= defined $$infoVals{hr} ? sprintf("-%03dhr", $$infoVals{hr}) : "-___hr";
        $infoFmt .= defined $$infoVals{offset} ? sprintf("-%doffset", $$infoVals{offset}) : "";
        $infoFmt .= defined $$infoVals{hrmax} ? sprintf("-%dhrmax", $$infoVals{hrmax}) : "";
        $infoFmt .= defined $$infoVals{isEnd} ? "-end" : "";
      }
    }else{
      $$entry{errorMsg} = "could not determine type for $$entry{infoStr}\n";
      next;
    }

    my $newFileName = "$$entry{fileBaseName}_$infoFmt.$$entry{fileExt}";
    my $newFile = "$$entry{dirName}/$newFileName";

    $$entry{fileNameInfoFmt} = $infoFmt;
    $$entry{newFile} = $newFile;
    $$entry{success} = 1;
  }

  return $result;
}

sub mtime($){
  my ($file) = @_;
  my @stat = stat $file;
  return $stat[9];
}

&main(@ARGV);
