#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);

sub getFileNames($);
sub encodeWavFile($);
sub restoreWavFile($);
sub xdeltaCreatePatch($$$);
sub xdeltaApplyPatch($$$);
sub run(@);
sub tryrun(@);
sub readProc(@);

my $EXEC = basename $0;

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC ORIG_WAV_FILE [ORIG_WAV_FILE ORIG_WAV_FILE ..]
    produce a flac file and an xdelta patch that can recover the bitwise exact wav file
    -for each ORIG_WAV_FILE:
      -calculate file names:
        BASE_FILE       ORIG_WAV_FILE with '.wav' suffix removed
        FLAC_FILE       BASE_FILE + '.flac'
        TEMP_WAV_FILE   BASE_FILE + '-flac-decode.wav'
        XDELTA_FILE     BASE_FILE + '.xdelta'
      -encode ORIG_WAV_FILE to FLAC_FILE
      -decode FLAC_FILE to TEMP_WAV_FILE
      -diff the resulting TEMP_WAV_FILE and the ORIG_WAV_FILE to XDELTA_FILE
      -remove TEMP_WAV_FILE
    similar to:
      flac \$ORIG_WAV_FILE -o \$FLAC_FILE
      flac -d \$FLAC_FILE -o \$TEMP_WAV_FILE
      xdelta delta \$TEMP_WAV_FILE \$ORIG_WAV_FILE \$XDELTA_FILE
      rm \$TEMP_WAV_FILE

  $EXEC -d --decode  FLAC_FILE [FLAC_FILE FLAC_FILE ..]
  $EXEC -r|--restore FLAC_FILE [FLAC_FILE FLAC_FILE ..]
    recover the original wav file from the flac file and a similarly named xdelta patch
    -for each FLAC_FILE:
      -calculate file names:
        BASE_FILE       WAV_FILE with '.wav' suffix removed
        ORIG_WAV_FILE   BASE_FILE + '.flac'
        TEMP_WAV_FILE   BASE_FILE + '-flac-decode.wav'
        XDELTA_FILE     BASE_FILE + '.xdelta'
      -ensure that XDELTA_FILE exists
      -decode FLAC_FILE to TEMP_WAV_FILE
      -patch TEMP_WAV_FILE to produce ORIG_WAV_FILE
      -remove TEMP_WAV_FILE
    similar to
      flac -d \$FLAC_FILE -o \$TEMP_WAV_FILE
      xdelta patch \$XDELTA_FILE \$TEMP_WAV_FILE \$ORIG_WAV_FILE
      rm \$TEMP_WAV_FILE
";

my $MODE_ENCODE = "encode";
my $MODE_RESTORE = "restore";

sub main(@){
  my $mode = $MODE_ENCODE;
  my @files;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^(-d|--decode|-r|--restore)$/){
      $mode = $MODE_RESTORE;
    }elsif(-f $arg){
      push @files, $arg;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  if($mode eq $MODE_ENCODE){
    for my $file(@files){
      die "ERROR: WAV_FILE must end in '.wav'\n" if $file !~ /\.wav$/;
    }
    for my $file(@files){
      encodeWavFile(getFileNames($file));
    }
  }elsif($mode eq $MODE_RESTORE){
    for my $file(@files){
      die "ERROR: FLAC_FILE must end in '.flac'\n" if $file !~ /\.flac$/;
      my $fileNames = getFileNames($file);
      if(not -e $$fileNames{xdelta}){
        die "ERROR: xdelta file $$fileNames{xdelta} missing\n";
      }
    }
    for my $file(@files){
      restoreWavFile(getFileNames($file));
    }
  }else{
    die "ERROR: unknown mode $mode\n";
  }
}

sub getFileNames($){
  my ($file) = @_;
  my $baseFile = undef;
  if($file =~ /^(.*)\.(wav|flac)$/){
    $baseFile = $1;
  }else{
    die "ERROR: malformed file name $file\n";
  }

  return {
    origWav => "$baseFile.wav",
    tempWav => "$baseFile-flac-decode.wav",
    flac    => "$baseFile.flac",
    xdelta  => "$baseFile.xdelta",
  };
}

sub encodeWavFile($){
  my ($fileNames) = @_;

  die "ERROR: $$fileNames{origWav} missing\n" if not -e $$fileNames{origWav};

  die "ERROR: $$fileNames{flac} exists\n" if -e $$fileNames{flac};
  die "ERROR: $$fileNames{tempWav} exists\n" if -e $$fileNames{tempWav};
  die "ERROR: $$fileNames{xdelta} exists\n" if -e $$fileNames{xdelta};

  run "flac", $$fileNames{origWav}, "-o", $$fileNames{flac};
  run "flac", "-d", $$fileNames{flac}, "-o", $$fileNames{tempWav};

  xdeltaCreatePatch $$fileNames{tempWav}, $$fileNames{origWav}, $$fileNames{xdelta};
  run "touch", $$fileNames{xdelta}, "-r", $$fileNames{origWav};

  run "rm", $$fileNames{tempWav};
}

sub restoreWavFile($){
  my ($fileNames) = @_;

  die "ERROR: $$fileNames{flac} missing\n" if not -e $$fileNames{flac};
  die "ERROR: $$fileNames{xdelta} missing\n" if not -e $$fileNames{xdelta};

  die "ERROR: $$fileNames{origWav} exists\n" if -e $$fileNames{origWav};
  die "ERROR: $$fileNames{tempWav} exists\n" if -e $$fileNames{tempWav};

  run "flac", "-d", $$fileNames{flac}, "-o", $$fileNames{tempWav};

  xdeltaApplyPatch $$fileNames{xdelta}, $$fileNames{tempWav}, $$fileNames{origWav};
  run "touch", $$fileNames{origWav}, "-r", $$fileNames{flac};

  run "rm", $$fileNames{tempWav};
}

sub xdeltaCreatePatch($$$){
  my ($oldFile, $newFile, $patchFile) = @_;

  my @cmd = ("xdelta", "delta", $oldFile, $newFile, $patchFile);

  my $exitCode = tryrun @cmd;
  if($exitCode == 1){
    #success (xdelta is weird)
    return;
  }elsif($exitCode == 0){
    die "ERROR: xdelta delta reported empty diff\n";
  }else{
    die "ERROR: xdelta delta command @cmd failed\n";
  }
}

sub xdeltaApplyPatch($$$){
  my ($patchFile, $oldFile, $newFile) = @_;

  my @cmd = ("xdelta", "patch", $patchFile, $oldFile, $newFile);
  #normal exit statuses
  run @cmd;
}

sub run(@){
  my $exitCode = tryrun(@_);
  if($exitCode != 0){
    die "ERROR: \"@_\" failed\n$!\n";
  }
}
sub tryrun(@){
  print "@_\n";
  system @_;
  my $exitCode = $? >> 8;
  return $exitCode;
}
sub readProc(@){
  open my $cmdH, "-|", @_ or die "ERROR: could not run cmd '@_'\n$!\n";
  my @lines = <$cmdH>;
  close $cmdH;
  if(wantarray){
    return @lines;
  }else{
    return join '', @lines;
  }
}

&main(@ARGV);
