#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);
use Time::HiRes qw(time);

sub renameApk($$$);
sub run(@);
sub readProc(@);
sub nowMillis();

my $EXEC = basename $0;

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC [OPTS] APP_SHORT_NAME APK_FILE
    rename APK_FILE using aapt badging info

    new file format is:
    <APP_SHORT_NAME>_<APP_PKG_NAME>_<APP_VERSION_NAME>.<APK_EXT>
    e.g.: chrome_com.android.chrome_67.0.3396.87.apk

  $EXEC [OPTS] APK_FILE [APK_FILE APK_FILE ..]
    for each APK_FILE:
      -ensure APK_FILE starts with at least 3 letters/numbers
      -use this group of letters and numbers as APP_SHORT_NAME
      -same as: $0 APP_SHORT_NAME APK_FILE

  OPTS

  APP_SHORT_NAME
    three or more letters or numbers
  APP_PKG_NAME
    two or more words (alphanum or underscore) joined with period '.'
  APP_VERSION_NAME
    a digit, or a 'v' followed by a digit, followed by anything
  APK_EXT
    'apk' or 'xapk' or 'apkm'
";

sub main(@){
  my $appShortName = undef;
  my @apkFiles;
  my $opts = {
  };
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^([a-zA-Z0-9]+)$/ and not defined $appShortName){
      $appShortName = $1;
    }elsif(-f $arg){
      push @apkFiles, $arg;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  if(@apkFiles == 0){
    die "$USAGE\nERROR: no APK_FILE given\n";
  }elsif(@apkFiles > 1 and defined $appShortName){
    die "$USAGE\nERROR: must give exactly one APK_FILE with APP_SHORT_NAME\n";
  }

  for my $apkFile(@apkFiles){
    if($apkFile !~ /\.(apk|xapk|apkm)/i){
      die "$USAGE\nERROR: $apkFile must end in .apk/.xapk/.apkm\n";
    }

    my $apkFileAppShortName;
    if(defined $appShortName and @apkFiles == 1){
      $apkFileAppShortName = $appShortName;
    }elsif($apkFile =~ /^(?:.*\/)?([a-zA-Z0-9]{3,}).*\.(?:apk|xapk|apkm)$/i){
      $apkFileAppShortName = $1;
    }else{
      die "ERROR: could not extract app short name from $apkFile\n";
    }

    renameApk $opts, $apkFileAppShortName, $apkFile;
  }
}

sub renameApk($$$){
  my ($opts, $appShortName, $apkFile) = @_;
  my @aaptLines;
  my $tmpDir = undef;
  if($apkFile =~ /\.(xapk|apkm)$/i){
    $tmpDir = "/tmp/apk-name-split-" . nowMillis();
    run "unzip", "-qq", "-d", $tmpDir, $apkFile;
    my @apks =
      grep {$_ !~ /^(.*\/)?config[^\/]*.apk$/}
      grep {$_ !~ /^(.*\/)?split_config[^\/]*.apk$/}
      grep {$_ !~ /^(.*\/)?split_.*asset.*[^\/]*.apk$/i}
      grep {-f $_}
      glob "$tmpDir/*.apk";
    if(@apks == 1){
      @aaptLines = readProc "aapt", "dump", "badging", $apks[0];
    }else{
      run "rm", "-rf", "$tmpDir/";
      die "ERROR: could not extract target apk from XAPK/APKM $apkFile\n";
    }
  }else{
    @aaptLines = readProc "aapt", "dump", "badging", $apkFile;
  }
  if(defined $tmpDir){
    run "rm", "-rf", "$tmpDir/";
  }

  my %info;
  for my $line(@aaptLines){
    $info{name} = $1    if $line =~ /^package:.*\sname=['"]([^'"]+)['"]/;
    $info{version} = $1 if $line =~ /^package:.*\sversionName=['"]([^'"]+)['"]/;
  }

  die "ERROR: could not find app name with aapt\n" if not defined $info{name};
  die "ERROR: could not find app version with aapt\n" if not defined $info{version};

  if($info{name} !~ /^[a-zA-Z0-9_\-\.]+$/){
    die "ERROR: app name can container only letters/numbers/underscores/hyphens/periods\n";
  }

  $info{version} =~ s/[^a-zA-Z0-9_\-\.]+/_/g;
  $info{version} =~ s/^_+//g;
  $info{version} =~ s/_+$//g;

  my $newApkFileName = "${appShortName}_$info{name}_$info{version}";

  if($apkFile !~ /^(.*\/)?([^\/]+)\.(apk|xapk|apkm)$/i){
    die "ERROR: could not parse old APK filename\n";
  }
  my ($dir, $oldApkFileName, $ext) = ($1, $2, $3);
  $dir = "" if not defined $dir;

  my $newApkFile = $dir . $newApkFileName . "." . lc($ext);

  if($apkFile eq $newApkFile){
    print "apk file already named $newApkFile\n";
    return;
  }

  if(-e $newApkFile){
    die "ERROR: $newApkFile already exists\n";
  }

  my @cmd = ("mv", $apkFile, $newApkFile);
  print "@cmd\n";
  system @cmd;
  die "ERROR: error running @cmd\n" if $? != 0;
}

sub run(@){
  print "@_\n";
  system @_;
}

sub readProc(@){
  my @cmd = @_;
  open my $cmdH, "-|", @cmd or die "ERROR: @cmd failed\n$!\n";
  my @lines = <$cmdH>;
  close $cmdH;
  if(wantarray){
    return @lines;
  }else{
    return join("", @lines);
  }
}

sub nowMillis(){
  return int(time() * 1000.0 + 0.5);
}

&main(@ARGV);
