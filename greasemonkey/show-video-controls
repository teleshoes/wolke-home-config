// ==UserScript==
// @name     show-video-controls
// @version  1
// @grant    none
// ==/UserScript==

// press F8 to enable
var stateEnabled = false;

function videoDo(f){
  var videos = document.getElementsByTagName("video");
  for (let i = 0; i < videos.length; i++) {
    f(videos[i]);
  }
}

function videoSeek(v, s){
  v.currentTime += s;
}

function videoPlayPause(v){
  if(v.paused){
    v.play();
  }else{
    v.pause();
  }
}

function videoToggleControls(v){
  if(v.hasAttribute("controls")){
    v.removeAttribute("controls");
  }else{
    v.setAttribute("controls", "controls");
  }
}

(function() {
  'use strict';
  document.querySelector('body').addEventListener("keydown", (event) => {
    if(event.key === "F8"){
      stateEnabled = !stateEnabled;
    }

    if(stateEnabled){
      if(event.key === "i"){
        videoDo(videoToggleControls);
      }else if(event.key === "k"){
        videoDo(videoPlayPause);
      }else if(event.key === "j"){
        videoDo((v) => videoSeek(v, -5));
      }else if(event.key === "l"){
        videoDo((v) => videoSeek(v, 5));
      }
    }
  });
})();
